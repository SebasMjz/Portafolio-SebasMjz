div class=\"w-14 h-14 bg-[#010B13] rounded-2xl flex items-center justify-center mb-8 border border-white/10 group-hover:border-[#8A2BE2]/50 transition-colors\" data-kid=\"1-3-2-2-2-1\" data-name=\"service icon box\">\n                        <i class=\"ti ti-device-mobile text-3xl text-[#8A2BE2]\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"mobile device icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-jakarta text-2xl font-bold mb-4\" data-kid=\"1-3-2-2-2-2\" data-name=\"service title\">\n                        Apps Móviles\n                    </h3>\n                    <p class=\"text-white/40 leading-relaxed text-sm mb-8\" data-kid=\"1-3-2-2-2-3\" data-name=\"service description\">\n                        Experiencias nativas fluidas optimizadas para hardware de alto rendimiento y UX intuitiva.\n                    </p>\n                    <a class=\"flex items-center gap-3 text-[#8A2BE2] font-black text-[10px] uppercase tracking-widest group-hover:gap-5 transition-all\" data-kid=\"1-3-2-2-2-4\" data-name=\"service explore link\" href=\"#\">\n                        EXPLORAR SISTEMA\n                        <i class=\"ti ti-chevron-right\" data-kid=\"1-3-2-2-2-4-1\" data-name=\"chevron icon\">\n                        </i>\n                    </a>\n                </div>\n                <!-- Desktop (Regular) -->\n                <div class=\"service-card glass-card p-10 rounded-[40px] border border-white/5 group hover:border-[#00FFFF]/30 transition-colors\" data-kid=\"1-3-2-2-3\" data-name=\"desktop services card\">\n                    <div class=\"w-14 h-14 bg-[#010B13] rounded-2xl flex items-center justify-center mb-8 border border-white/10 group-hover:border-[#00FFFF]/50 transition-colors\" data-kid=\"1-3-2-2-3-1\" data-name=\"service icon box\">\n                        <i class=\"ti ti-terminal text-3xl text-[#00FFFF]\" data-kid=\"1-3-2-2-3-1-1\" data-name=\"terminal icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-jakarta text-2xl font-bold mb-4\" data-kid=\"1-3-2-2-3-2\" data-name=\"service title\">\n                        Software Desktop\n                    </h3>\n                    <p class=\"text-white/40 leading-relaxed text-sm mb-8\" data-kid=\"1-3-2-2-3-3\" data-name=\"service description\">\n                        Aplicaciones robustas para procesos que requieren integración local profunda y potencia de CPU.\n                    </p>\n                    <a class=\"flex items-center gap-3 text-[#00FFFF] font-black text-[10px] uppercase tracking-widest group-hover:gap-5 transition-all\" data-kid=\"1-3-2-2-3-4\" data-name=\"service explore link\" href=\"#\">\n                        EXPLORAR SISTEMA\n                        <i class=\"ti ti-chevron-right\" data-kid=\"1-3-2-2-3-4-1\" data-name=\"chevron icon\">\n                        </i>\n                    </a>\n                </div>\n                <!-- Sistemas Core (Wide Featured) -->\n                <div class=\"service-card lg:col-span-2 glass-card p-12 rounded-[40px] border border-white/5 relative overflow-hidden group\" data-kid=\"1-3-2-2-4\" data-name=\"systems architecture service card\">\n                    <div class=\"absolute -bottom-20 -left-20 w-80 h-80 bg-[#8A2BE2]/5 blur-[100px] group-hover:bg-[#8A2BE2]/10 transition-colors duration-700\" data-kid=\"1-3-2-2-4-1\" data-name=\"service card glow\">\n                    </div>\n                    <div class=\"flex flex-col md:flex-row-reverse gap-12 items-center text-right md:text-left\" data-kid=\"1-3-2-2-4-2\" data-name=\"service card layout\">\n                        <div class=\"flex-1 space-y-6\" data-kid=\"1-3-2-2-4-2-1\" data-name=\"service info column\">\n                            <div class=\"w-16 h-16 bg-[#010B13] rounded-2xl flex items-center justify-center border border-white/10 group-hover:border-[#8A2BE2]/40 transition-colors duration-500 ml-auto md:ml-0\" data-kid=\"1-3-2-2-4-2-1-1\" data-name=\"service icon box\">\n                                <i class=\"ti ti-database-cog text-4xl text-[#8A2BE2]\" data-kid=\"1-3-2-2-4-2-1-1-1\" data-name=\"database cog icon\">\n                                </i>\n                            </div>\n                            <h3 class=\"font-jakarta text-3xl font-bold\" data-kid=\"1-3-2-2-4-2-1-2\" data-name=\"service title\">\n                                Arquitectura de Sistemas\n                            </h3>\n                            <p class=\"text-white/40 leading-relaxed\" data-kid=\"1-3-2-2-4-2-1-3\" data-name=\"service description\">\n                                Diseño de APIs, orquestación de microservicios y modernización de infraestructuras críticas heredadas.\n                            </p>\n                        </div>\n                        <div class=\"hidden md:block w-px h-40 bg-white/5\" data-kid=\"1-3-2-2-4-2-2\" data-name=\"vertical separator line\">\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-4 w-full md:w-auto\" data-kid=\"1-3-2-2-4-2-3\" data-name=\"technical badges container\">\n                            <div class=\"p-4 bg-white/5 rounded-2xl border border-white/5 text-center\" data-kid=\"1-3-2-2-4-2-3-1\" data-name=\"badge 1 container\">\n                                <div class=\"text-[#8A2BE2] font-jakarta font-bold text-xl\" data-kid=\"1-3-2-2-4-2-3-1-1\" data-name=\"badge text\">\n                                    API\n                                </div>\n                                <div class=\"text-[8px] text-white/30 uppercase font-bold mt-1 tracking-widest\" data-kid=\"1-3-2-2-4-2-3-1-2\" data-name=\"badge label\">\n                                    DESIGN\n                                </div>\n                            </div>\n                            <div class=\"p-4 bg-white/5 rounded-2xl border border-white/5 text-center\" data-kid=\"1-3-2-2-4-2-3-2\" data-name=\"badge 2 container\">\n                                <div class=\"text-[#8A2BE2] font-jakarta font-bold text-xl\" data-kid=\"1-3-2-2-4-2-3-2-1\" data-name=\"badge text\">\n                                    OPS\n                                </div>\n                                <div class=\"text-[8px] text-white/30 uppercase font-bold mt-1 tracking-widest\" data-kid=\"1-3-2-2-4-2-3-2-2\" data-name=\"badge label\">\n                                    DATABASES\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Process Section -->\n    <section class=\"py-24 px-6 bg-[#010B13]\" data-kid=\"1-4\" data-name=\"process section\" id=\"proceso\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-4-1\" data-name=\"process content wrapper\">\n            <div class=\"text-center mb-24\" data-kid=\"1-4-1-1\" data-name=\"process header section\">\n                <h2 class=\"font-jakarta text-4xl md:text-5xl font-bold mb-6\" data-kid=\"1-4-1-1-1\" data-name=\"section title\">\n                    El Camino NoRest\n                </h2>\n                <p class=\"text-white/50 text-lg max-w-2xl mx-auto\" data-kid=\"1-4-1-1-2\" data-name=\"section description\">\n                    Metodología de precisión militar aplicada al desarrollo de software comercial.\n                </p>\n            </div>\n            <div class=\"relative\" data-kid=\"1-4-1-2\" data-name=\"process steps container\">\n                <!-- Horizontal Progress Line -->\n                <div class=\"absolute top-1/2 left-0 w-full h-[1px] bg-white/5 -translate-y-1/2 hidden lg:block overflow-hidden\" data-kid=\"1-4-1-2-1\" data-name=\"horizontal progress line container\">\n                    <div class=\"h-full bg-gradient-to-r from-[#00FFFF] to-[#8A2BE2] w-0 shadow-[0_0_15px_rgba(0,255,255,0.5)]\" data-dynamic=\"true\" data-kid=\"1-4-1-2-1-1\" data-name=\"progress line bar\" data-reason=\"width animated by scrolltrigger script\" id=\"process-line-draw\">\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 relative z-10\" data-kid=\"1-4-1-2-2\" data-name=\"steps grid\">\n                    <!-- Discover -->\n                    <div class=\"process-step group text-center lg:text-left\" data-kid=\"1-4-1-2-2-1\" data-name=\"process step 1\">\n                        <div class=\"w-20 h-20 bg-[#1A1A24] border border-white/10 rounded-2xl flex items-center justify-center mb-8 mx-auto lg:mx-0 group-hover:border-[#00FFFF] transition-all transform group-hover:-translate-y-2\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"step icon box\">\n                            <i class=\"ti ti-zoom-check text-3xl text-white/30 group-hover:text-[#00FFFF] transition-colors\" data-kid=\"1-4-1-2-2-1-1-1\" data-name=\"zoom check icon\">\n                            </i>\n                        </div>\n                        <h3 class=\"font-jakarta text-2xl font-bold mb-4\" data-kid=\"1-4-1-2-2-1-2\" data-name=\"step title\">\n                            Discover\n                        </h3>\n                        <p class=\"text-white/40 text-sm leading-relaxed pr-4\" data-kid=\"1-4-1-2-2-1-3\" data-name=\"step description\">\n                            Inmersión profunda en tu modelo de negocio para identificar fricciones y oportunidades.\n                        </p>\n                        <div class=\"mt-4 flex items-center justify-center lg:justify-start gap-4\" data-kid=\"1-4-1-2-2-1-4\" data-name=\"tags container\">\n                            <span class=\"text-[10px] font-mono text-[#00FFFF]/50 bg-[#00FFFF]/5 px-2 py-1 rounded\" data-kid=\"1-4-1-2-2-1-4-1\" data-name=\"tag 1\">\n                                AUDIT\n                            </span>\n                            <span class=\"text-[10px] font-mono text-[#00FFFF]/50 bg-[#00FFFF]/5 px-2 py-1 rounded\" data-kid=\"1-4-1-2-2-1-4-2\" data-name=\"tag 2\">\n                                UX MAP\n                            </span>\n                        </div>\n                    </div>\n                    <!-- Build -->\n                    <div class=\"process-step group text-center lg:text-left\" data-kid=\"1-4-1-2-2-2\" data-name=\"process step 2\">\n                        <div class=\"w-20 h-20 bg-[#1A1A24] border border-white/10 rounded-2xl flex items-center justify-center mb-8 mx-auto lg:mx-0 group-hover:border-[#8A2BE2] transition-all transform group-hover:-translate-y-2\" data-kid=\"1-4-1-2-2-2-1\" data-name=\"step icon box\">\n                            <i class=\"ti ti-code-circle text-3xl text-white/30 group-hover:text-[#8A2BE2] transition-colors\" data-kid=\"1-4-1-2-2-2-1-1\" data-name=\"code circle icon\">\n                            </i>\n                        </div>\n                        <h3 class=\"font-jakarta text-2xl font-bold mb-4\" data-kid=\"1-4-1-2-2-2-2\" data-name=\"step title\">\n                            Build\n                        </h3>\n                        <p class=\"text-white/40 text-sm leading-relaxed pr-4\" data-kid=\"1-4-1-2-2-2-3\" data-name=\"step description\">\n                            Desarrollo modular bajo estándares ISO. Código que es poesía técnica y eficiencia funcional.\n                        </p>\n                        <div class=\"mt-4 flex items-center justify-center lg:justify-start gap-4\" data-kid=\"1-4-1-2-2-2-4\" data-name=\"tags container\">\n                            <span class=\"text-[10px] font-mono text-[#8A2BE2]/50 bg-[#8A2BE2]/5 px-2 py-1 rounded\" data-kid=\"1-4-1-2-2-2-4-1\" data-name=\"tag 1\">\n                                AGILE\n                            </span>\n                            <span class=\"text-[10px] font-mono text-[#8A2BE2]/50 bg-[#8A2BE2]/5 px-2 py-1 rounded\" data-kid=\"1-4-1-2-2-2-4-2\" data-name=\"tag 2\">\n                                QA SPRINT\n                            </span>\n                        </div>\n                    </div>\n                    <!-- Test -->\n                    <div class=\"process-step group text-center lg:text-left\" data-kid=\"1-4-1-2-2-3\" data-name=\"process step 3\">\n                        <div class=\"w-20 h-20 bg-[#1A1A24] border border-white/10 rounded-2xl flex items-center justify-center mb-8 mx-auto lg:mx-0 group-hover:border-[#00FFFF] transition-all transform group-hover:-translate-y-2\" data-kid=\"1-4-1-2-2-3-1\" data-name=\"step icon box\">\n                            <i class=\"ti ti-brand-speedtest text-3xl text-white/30 group-hover:text-[#00FFFF] transition-colors\" data-kid=\"1-4-1-2-2-3-1-1\" data-name=\"brand speedtest icon\">\n                            </i>\n                        </div>\n                        <h3 class=\"font-jakarta text-2xl font-bold mb-4\" data-kid=\"1-4-1-2-2-3-2\" data-name=\"step title\">\n                            Test\n                        </h3>\n                        <p class=\"text-white/40 text-sm leading-relaxed pr-4\" data-kid=\"1-4-1-2-2-3-3\" data-name=\"step description\">\n                            Pruebas de estrés, seguridad y usabilidad. Nada sale al aire sin validación absoluta.\n                        </p>\n                        <div class=\"mt-4 flex items-center justify-center lg:justify-start gap-4\" data-kid=\"1-4-1-2-2-3-4\" data-name=\"tags container\">\n                            <span class=\"text-[10px] font-mono text-[#00FFFF]/50 bg-[#00FFFF]/5 px-2 py-1 rounded\" data-kid=\"1-4-1-2-2-3-4-1\" data-name=\"tag 1\">\n                                PENTEST\n                            </span>\n                            <span class=\"text-[10px] font-mono text-[#00FFFF]/50 bg-[#00FFFF]/5 px-2 py-1 rounded\" data-kid=\"1-4-1-2-2-3-4-2\" data-name=\"tag 2\">\n                                STRESS\n                            </span>\n                        </div>\n                    </div>\n                    <!-- Launch -->\n                    <div class=\"process-step group text-center lg:text-left\" data-kid=\"1-4-1-2-2-4\" data-name=\"process step 4\">\n                        <div class=\"w-20 h-20 bg-[#1A1A24] border border-white/10 rounded-2xl flex items-center justify-center mb-8 mx-auto lg:mx-0 group-hover:border-[#8A2BE2] transition-all transform group-hover:-translate-y-2\" data-kid=\"1-4-1-2-2-4-1\" data-name=\"step icon box\">\n                            <i class=\"ti ti-world-upload text-3xl text-white/30 group-hover:text-[#8A2BE2] transition-colors\" data-kid=\"1-4-1-2-2-4-1-1\" data-name=\"world upload icon\">\n                            </i>\n                        </div>\n                        <h3 class=\"font-jakarta text-2xl font-bold mb-4\" data-kid=\"1-4-1-2-2-4-2\" data-name=\"step title\">\n                            Launch\n                        </h3>\n                        <p class=\"text-white/40 text-sm leading-relaxed pr-4\" data-kid=\"1-4-1-2-2-4-3\" data-name=\"step description\">\n                            Despliegue automatizado y monitoreo preventivo. Tu negocio nunca descansa.\n                        </p>\n                        <div class=\"mt-4 flex items-center justify-center lg:justify-start gap-4\" data-kid=\"1-4-1-2-2-4-4\" data-name=\"tags container\">\n                            <span class=\"text-[10px] font-mono text-[#8A2BE2]/50 bg-[#8A2BE2]/5 px-2 py-1 rounded\" data-kid=\"1-4-1-2-2-4-4-1\" data-name=\"tag 1\">\n                                DEVOPS\n                            </span>\n                            <span class=\"text-[10px] font-mono text-[#8A2BE2]/50 bg-[#8A2BE2]/5 px-2 py-1 rounded\" data-kid=\"1-4-1-2-2-4-4-2\" data-name=\"tag 2\">\n                                SCALE\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Case Studies Section -->\n    <section class=\"py-24 px-6 bg-[#050E16] overflow-hidden\" data-kid=\"1-5\" data-name=\"case studies section\" id=\"proyectos\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-5-1\" data-name=\"content wrapper\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\" data-kid=\"1-5-1-1\" data-name=\"split grid content\">\n                <!-- Left: Technical Metrics & Quote -->\n                <div class=\"space-y-12\" data-kid=\"1-5-1-1-1\" data-name=\"left column\">\n                    <div class=\"space-y-6\" data-kid=\"1-5-1-1-1-1\" data-name=\"header info\">\n                        <h2 class=\"font-jakarta text-4xl md:text-6xl font-extrabold\" data-kid=\"1-5-1-1-1-1-1\" data-name=\"main title\">\n                            Resultados Reales\n                        </h2>\n                        <p class=\"text-white/50 text-lg\" data-kid=\"1-5-1-1-1-1-2\" data-name=\"description text\">\n                            No solo entregamos código; entregamos impacto medible para líderes en la industria logística.\n                        </p>\n                    </div>\n                    <div class=\"space-y-8\" data-kid=\"1-5-1-1-1-2\" data-name=\"results row list\">\n                        <div class=\"case-result-row flex items-center gap-6 p-6 glass-card rounded-2xl border-l-4 border-l-[#00FFFF]\" data-kid=\"1-5-1-1-1-2-1\" data-name=\"result row 1\">\n                            <div class=\"text-4xl font-jakarta font-extrabold text-[#00FFFF]\" data-kid=\"1-5-1-1-1-2-1-1\" data-name=\"result stat value\">\n                                -40%\n                            </div>\n                            <div data-kid=\"1-5-1-1-1-2-1-2\" data-name=\"result description container\">\n                                <div class=\"font-bold\" data-kid=\"1-5-1-1-1-2-1-2-1\" data-name=\"result title\">\n                                    Latencia de Reducción\n                                </div>\n                                <div class=\"text-sm text-white/40 text-pretty\" data-kid=\"1-5-1-1-1-2-1-2-2\" data-name=\"result body\">\n                                    Optimización de core backend para despacho global.\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"case-result-row flex items-center gap-6 p-6 glass-card rounded-2xl border-l-4 border-l-[#8A2BE2]\" data-kid=\"1-5-1-1-1-2-2\" data-name=\"result row 2\">\n                            <div class=\"text-4xl font-jakarta font-extrabold text-[#8A2BE2]\" data-kid=\"1-5-1-1-1-2-2-1\" data-name=\"result stat value\">\n                                1.2M\n                            </div>\n                            <div data-kid=\"1-5-1-1-1-2-2-2\" data-name=\"result description container\">\n                                <div class=\"font-bold\" data-kid=\"1-5-1-1-1-2-2-2-1\" data-name=\"result title\">\n                                    Transacciones Diarias\n                                </div>\n                                <div class=\"text-sm text-white/40 text-pretty\" data-kid=\"1-5-1-1-1-2-2-2-2\" data-name=\"result body\">\n                                    Escalabilidad masiva en entorno cloud altamente volátil.\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"pt-8 border-t border-white/5\" data-kid=\"1-5-1-1-1-3\" data-name=\"testimony container\">\n                        <p class=\"italic text-xl text-white/80 leading-relaxed mb-6\" data-kid=\"1-5-1-1-1-3-1\" data-name=\"testimony text\">\n                            \"La transición a la nueva plataforma web fue impecable. NoRest Solutions entendió que para nosotros, el tiempo de inactividad no es una opción.\"\n                        </p>\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-5-1-1-1-3-2\" data-name=\"testimony author container\">\n                            <div class=\"w-12 h-12 bg-[#1A1A24] rounded-full border border-white/10 flex items-center justify-center\" data-kid=\"1-5-1-1-1-3-2-1\" data-name=\"author profile image container\">\n                                <i class=\"ti ti-user text-xl text-white/40\" data-kid=\"1-5-1-1-1-3-2-1-1\" data-name=\"user icon\">\n                                </i>\n                            </div>\n                            <div data-kid=\"1-5-1-1-1-3-2-2\" data-name=\"author details\">\n                                <div class=\"font-bold\" data-kid=\"1-5-1-1-1-3-2-2-1\" data-name=\"author name\">\n                                    Ricardo Valenzuela\n                                </div>\n                                <div class=\"text-xs text-white/40 uppercase tracking-widest\" data-kid=\"1-5-1-1-1-3-2-2-2\" data-name=\"author role\">\n                                    Director de Operaciones, Logistics Co.\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- Right: Split Overflow Image -->\n                <div class=\"relative group\" data-kid=\"1-5-1-1-2\" data-name=\"right visual column\">\n                    <div class=\"absolute -inset-4 bg-gradient-to-tr from-[#00FFFF]/10 to-[#8A2BE2]/10 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700\" data-kid=\"1-5-1-1-2-1\" data-name=\"visual container glow\">\n                    </div>\n                    <div class=\"relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl\" data-kid=\"1-5-1-1-2-2\" data-name=\"main image container\">\n                        <img alt=\"Dashboard Interface by Luke Chesser\" class=\"w-full h-auto transform group-hover:scale-105 transition-transform duration-700\" data-kid=\"1-5-1-1-2-2-1\" data-name=\"case study interface image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&w=1000&q=80&fit=crop\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#010B13] via-transparent to-transparent opacity-60\" data-kid=\"1-5-1-1-2-2-2\" data-name=\"overlay gradient\">\n                        </div>\n                    </div>\n                    <!-- Overlapping Technical Card -->\n                    <div class=\"absolute -bottom-12 -left-10 md:-left-20 w-80 glass-card p-10 rounded-[40px] border border-white/10 shadow-[0_40px_80px_-20px_rgba(0,0,0,0.9)] hidden md:block z-20\" data-kid=\"1-5-1-1-2-3\" data-name=\"technical metrics card\">\n                        <div class=\"flex items-center justify-between mb-8\" data-kid=\"1-5-1-1-2-3-1\" data-name=\"metric card header\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-5-1-1-2-3-1-1\" data-name=\"status container\">\n                                <div class=\"w-2 h-2 rounded-full bg-[#00FF00] animate-pulse\" data-kid=\"1-5-1-1-2-3-1-1-1\" data-name=\"pulse indicator\">\n                                </div>\n                                <span class=\"text-[9px] font-black uppercase tracking-[0.2em] text-white/30\" data-kid=\"1-5-1-1-2-3-1-1-2\" data-name=\"status label\">\n                                    SYSTEM_HEALTH\n                                </span>\n                            </div>\n                            <div class=\"text-[9px] font-mono text-[#00FFFF]\" data-kid=\"1-5-1-1-2-3-1-2\" data-name=\"status state text\">\n                                OPERATIONAL\n                            </div>\n                        </div>\n                        <div class=\"space-y-6\" data-kid=\"1-5-1-1-2-3-2\" data-name=\"metrics gauges list\">\n                            <div class=\"space-y-2\" data-kid=\"1-5-1-1-2-3-2-1\" data-name=\"cpu gauge\">\n                                <div class=\"flex justify-between text-[9px] font-bold text-white/40 uppercase tracking-[0.2em]\" data-kid=\"1-5-1-1-2-3-2-1-1\" data-name=\"gauge label row\">\n                                    <span data-kid=\"1-5-1-1-2-3-2-1-1-1\" data-name=\"gauge label\">\n                                        CORE_CPU\n                                    </span>\n                                    <span data-kid=\"1-5-1-1-2-3-2-1-1-2\" data-name=\"gauge value\">\n                                        74.2%\n                                    </span>\n                                </div>\n                                <div class=\"h-1.5 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"1-5-1-1-2-3-2-1-2\" data-name=\"gauge bar background\">\n                                    <div class=\"h-full bg-[#00FFFF] w-3/4 shadow-[0_0_10px_#00FFFF]\" data-kid=\"1-5-1-1-2-3-2-1-2-1\" data-name=\"gauge fill\">\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"space-y-2\" data-kid=\"1-5-1-1-2-3-2-2\" data-name=\"mem gauge\">\n                                <div class=\"flex justify-between text-[9px] font-bold text-white/40 uppercase tracking-[0.2em]\" data-kid=\"1-5-1-1-2-3-2-2-1\" data-name=\"gauge label row\">\n                                    <span data-kid=\"1-5-1-1-2-3-2-2-1-1\" data-name=\"gauge label\">\n                                        MEM_HEAP\n                                    </span>\n                                    <span data-kid=\"1-5-1-1-2-3-2-2-1-2\" data-name=\"gauge value\">\n                                        42.8%\n                                    </span>\n                                </div>\n                                <div class=\"h-1.5 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"1-5-1-1-2-3-2-2-2\" data-name=\"gauge bar background\">\n                                    <div class=\"h-full bg-[#8A2BE2] w-1/2 shadow-[0_0_10px_#8A2BE2]\" data-kid=\"1-5-1-1-2-3-2-2-2-1\" data-name=\"gauge fill\">\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"space-y-2\" data-kid=\"1-5-1-1-2-3-2-3\" data-name=\"net io gauge\">\n                                <div class=\"flex justify-between text-[9px] font-bold text-white/40 uppercase tracking-[0.2em]\" data-kid=\"1-5-1-1-2-3-2-3-1\" data-name=\"gauge label row\">\n                                    <span data-kid=\"1-5-1-1-2-3-2-3-1-1\" data-name=\"gauge label\">\n                                        NET_IO\n                                    </span>\n                                    <span data-kid=\"1-5-1-1-2-3-2-3-1-2\" data-name=\"gauge value\">\n                                        89.1%\n                                    </span>\n                                </div>\n                                <div class=\"h-1.5 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"1-5-1-1-2-3-2-3-2\" data-name=\"gauge bar background\">\n                                    <div class=\"h-full bg-[#00FFFF] w-[89%] shadow-[0_0_10px_#00FFFF]\" data-kid=\"1-5-1-1-2-3-2-3-2-1\" data-name=\"gauge fill\">\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- FAQ Section -->\n    <section class=\"py-24 px-6 bg-[#010B13]\" data-kid=\"1-6\" data-name=\"faq section\" id=\"faq\">\n        <div class=\"max-w-7xl mx-auto flex flex-col lg:flex-row gap-20\" data-kid=\"1-6-1\" data-name=\"faq content wrapper\">\n            <!-- Sidebar Sticky -->\n            <div class=\"lg:w-1/3 lg:sticky lg:top-32 h-fit\" data-kid=\"1-6-1-1\" data-name=\"sticky sidebar\">\n                <div class=\"space-y-6\" data-kid=\"1-6-1-1-1\" data-name=\"faq info container\">\n                    <div class=\"inline-flex items-center gap-2 text-[#00FFFF] text-[10px] font-bold uppercase tracking-[0.3em]\" data-kid=\"1-6-1-1-1-1\" data-name=\"small badge\">\n                        <span class=\"w-8 h-[1px] bg-[#00FFFF]\" data-kid=\"1-6-1-1-1-1-1\" data-name=\"badge separator\">\n                        </span>\n                        AYUDA\n                    </div>\n                    <h2 class=\"font-jakarta text-4xl md:text-5xl font-bold leading-tight\" data-kid=\"1-6-1-1-1-2\" data-name=\"section title\">\n                        Resolviendo\n                        <span class=\"text-white/20\" data-kid=\"1-6-1-1-1-2-1\" data-name=\"title highlight\">\n                            tus dudas técnicas.\n                        </span>\n                    </h2>\n                    <p class=\"text-white/40 text-lg leading-relaxed\" data-kid=\"1-6-1-1-1-3\" data-name=\"section description\">\n                        Transparencia radical desde el primer contacto. Entendemos que tu inversión requiere seguridad absoluta.\n                    </p>\n                    <div class=\"pt-8\" data-kid=\"1-6-1-1-1-4\" data-name=\"action link container\">\n                        <a class=\"group inline-flex items-center gap-4 bg-white/5 border border-white/10 px-8 py-4 rounded-full text-xs font-black uppercase tracking-widest hover:bg-[#00FFFF] hover:text-[#010B13] hover:border-transparent transition-all duration-300\" data-kid=\"1-6-1-1-1-4-1\" data-name=\"action button\" href=\"#contacto\">\n                            HABLA CON UN EXPERTO\n                            <i class=\"ti ti-arrow-right group-hover:translate-x-1 transition-transform\" data-kid=\"1-6-1-1-1-4-1-1\" data-name=\"arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <!-- FAQ List -->\n            <div class=\"lg:w-2/3 space-y-4\" data-kid=\"1-6-1-2\" data-name=\"faq questions list\">\n                <div class=\"faq-item group glass-card border border-white/5 rounded-3xl p-6 cursor-pointer overflow-hidden hover:border-[#00FFFF]/30 transition-colors\" data-kid=\"1-6-1-2-1\" data-name=\"faq item 1\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-6-1-2-1-1\" data-name=\"question header\">\n                        <h3 class=\"font-jakarta text-lg font-bold text-white/70 group-hover:text-white transition-colors\" data-kid=\"1-6-1-2-1-1-1\" data-name=\"question title\">\n                            ¿Cuál es el tiempo promedio de entrega?\n                        </h3>\n                        <div class=\"w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-[#00FFFF] transition-colors\" data-kid=\"1-6-1-2-1-1-2\" data-name=\"toggle button\">\n                            <i class=\"ti ti-plus text-sm text-white/20 group-hover:text-[#00FFFF] transition-all transform group-hover:rotate-45\" data-kid=\"1-6-1-2-1-1-2-1\" data-name=\"plus icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"faq-answer hidden mt-6 text-white/40 leading-relaxed text-sm max-w-2xl border-t border-white/5 pt-6\" data-dynamic=\"true\" data-kid=\"1-6-1-2-1-2\" data-name=\"answer body\" data-reason=\"content display state toggled and height animated by script\">\n                        Depende de la complejidad, pero un MVP funcional suele tomar entre 8 y 12 semanas. Mantenemos ciclos de entrega de 2 semanas para transparencia constante.\n                    </div>\n                </div>\n                <div class=\"faq-item group glass-card border border-white/5 rounded-3xl p-6 cursor-pointer overflow-hidden hover:border-[#8A2BE2]/30 transition-colors\" data-kid=\"1-6-1-2-2\" data-name=\"faq item 2\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-6-1-2-2-1\" data-name=\"question header\">\n                        <h3 class=\"font-jakarta text-lg font-bold text-white/70 group-hover:text-white transition-colors\" data-kid=\"1-6-1-2-2-1-1\" data-name=\"question title\">\n                            ¿Trabajan con equipos de desarrollo internos?\n                        </h3>\n                        <div class=\"w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-[#8A2BE2] transition-colors\" data-kid=\"1-6-1-2-2-1-2\" data-name=\"toggle button\">\n                            <i class=\"ti ti-plus text-sm text-white/20 group-hover:text-[#8A2BE2] transition-all transform group-hover:rotate-45\" data-kid=\"1-6-1-2-2-1-2-1\" data-name=\"plus icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"faq-answer hidden mt-6 text-white/40 leading-relaxed text-sm max-w-2xl border-t border-white/5 pt-6\" data-dynamic=\"true\" data-kid=\"1-6-1-2-2-2\" data-name=\"answer body\" data-reason=\"content display state toggled and height animated by script\">\n                        Sí, funcionamos como un brazo de élite. Podemos encargarnos de proyectos completos o integrarnos en tu flujo de Git/Jira para potenciar tu equipo actual mediante Team Augmentation.\n                    </div>\n                </div>\n                <div class=\"faq-item group glass-card border border-white/5 rounded-3xl p-6 cursor-pointer overflow-hidden hover:border-[#00FFFF]/30 transition-colors\" data-kid=\"1-6-1-2-3\" data-name=\"faq item 3\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-6-1-2-3-1\" data-name=\"question header\">\n                        <h3 class=\"font-jakarta text-lg font-bold text-white/70 group-hover:text-white transition-colors\" data-kid=\"1-6-1-2-3-1-1\" data-name=\"question title\">\n                            ¿Ofrecen mantenimiento post-lanzamiento?\n                        </h3>\n                        <div class=\"w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-[#00FFFF] transition-colors\" data-kid=\"1-6-1-2-3-1-2\" data-name=\"toggle button\">\n                            <i class=\"ti ti-plus text-sm text-white/20 group-hover:text-[#00FFFF] transition-all transform group-hover:rotate-45\" data-kid=\"1-6-1-2-3-1-2-1\" data-name=\"plus icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"faq-answer hidden mt-6 text-white/40 leading-relaxed text-sm max-w-2xl border-t border-white/5 pt-6\" data-dynamic=\"true\" data-kid=\"1-6-1-2-3-2\" data-name=\"answer body\" data-reason=\"content display state toggled and height animated by script\">\n                        Absolutamente. Ofrecemos planes de soporte 24/7 y mantenimiento preventivo para asegurar que tus sistemas siempre operen en condiciones óptimas, incluyendo escalamiento de infraestructura bajo demanda.\n                    </div>\n                </div>\n                <div class=\"faq-item group glass-card border border-white/5 rounded-3xl p-6 cursor-pointer overflow-hidden hover:border-[#8A2BE2]/30 transition-colors\" data-kid=\"1-6-1-2-4\" data-name=\"faq item 4\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-6-1-2-4-1\" data-name=\"question header\">\n                        <h3 class=\"font-jakarta text-lg font-bold text-white/70 group-hover:text-white transition-colors\" data-kid=\"1-6-1-2-4-1-1\" data-name=\"question title\">\n                            ¿Qué tecnologías prefieren utilizar?\n                        </h3>\n                        <div class=\"w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-[#8A2BE2] transition-colors\" data-kid=\"1-6-1-2-4-1-2\" data-name=\"toggle button\">\n                            <i class=\"ti ti-plus text-sm text-white/20 group-hover:text-[#8A2BE2] transition-all transform group-hover:rotate-45\" data-kid=\"1-6-1-2-4-1-2-1\" data-name=\"plus icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"faq-answer hidden mt-6 text-white/40 leading-relaxed text-sm max-w-2xl border-t border-white/5 pt-6\" data-dynamic=\"true\" data-kid=\"1-6-1-2-4-2\" data-name=\"answer body\" data-reason=\"content display state toggled and height animated by script\">\n                        Somos agnósticos pero preferimos stacks modernos y seguros: React/Next.js para web, Flutter para móvil, Rust/Go/Node.js para backend escalable. Siempre priorizamos la mantenibilidad a largo plazo.\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Contact Form Section -->\n    <section class=\"py-24 px-6 bg-[#050E16]\" data-kid=\"1-7\" data-name=\"contact form section\" id=\"contacto\">\n        <div class=\"max-w-4xl mx-auto\" data-kid=\"1-7-1\" data-name=\"section container\">\n            <div class=\"bg-[#1A1A24] rounded-2xl border border-white/10 overflow-hidden shadow-2xl\" data-kid=\"1-7-1-1\" data-name=\"terminal window container\">\n                <!-- Terminal Header -->\n                <div class=\"bg-[#2A2A3A] px-6 py-4 flex items-center justify-between border-b border-white/5\" data-kid=\"1-7-1-1-1\" data-name=\"terminal header\">\n                    <div class=\"flex gap-2\" data-kid=\"1-7-1-1-1-1\" data-name=\"window control buttons container\">\n                        <div class=\"w-3 h-3 rounded-full bg-[#FF5F56]\" data-kid=\"1-7-1-1-1-1-1\" data-name=\"button 1\">\n                        </div>\n                        <div class=\"w-3 h-3 rounded-full bg-[#FFBD2E]\" data-kid=\"1-7-1-1-1-1-2\" data-name=\"button 2\">\n                        </div>\n                        <div class=\"w-3 h-3 rounded-full bg-[#27C93F]\" data-kid=\"1-7-1-1-1-1-3\" data-name=\"button 3\">\n                        </div>\n                    </div>\n                    <div class=\"text-white/30 text-xs font-mono tracking-widest\" data-kid=\"1-7-1-1-1-2\" data-name=\"terminal title text\">\n                        norest --intake-form\n                    </div>\n                    <div class=\"w-12\" data-kid=\"1-7-1-1-1-3\" data-name=\"spacer element\">\n                    </div>\n                </div>\n                <!-- Terminal Content -->\n                <div class=\"p-8 md:p-14 font-mono text-sm\" data-kid=\"1-7-1-1-2\" data-name=\"terminal content\">\n                    <div class=\"space-y-10\" data-kid=\"1-7-1-1-2-1\" data-name=\"screen area container\" id=\"terminal-screen\">\n                        <div class=\"flex items-start\" data-kid=\"1-7-1-1-2-1-1\" data-name=\"typewriter line container\">\n                            <span class=\"mr-4 text-[#00FFFF]\" data-kid=\"1-7-1-1-2-1-1-1\" data-name=\"prompt symbol\">\n                                $\n                            </span>\n                            <p class=\"typewriter-text text-[#00FFFF] h-6\" data-dynamic=\"true\" data-kid=\"1-7-1-1-2-1-1-2\" data-name=\"typewriter text field\" data-reason=\"text updated character by character by script\">\n                            </p>\n                        </div>\n                        <form class=\"space-y-8\" data-kid=\"1-7-1-1-2-1-2\" data-name=\"contact form\" id=\"contact-form\">\n                            <div class=\"space-y-2\" data-kid=\"1-7-1-1-2-1-2-1\" data-name=\"form field group 1\">\n                                <label class=\"block text-white/40 text-[10px] uppercase tracking-[0.3em] font-bold\" data-kid=\"1-7-1-1-2-1-2-1-1\" data-name=\"field label\">\n                                    01. NOMBRE COMPLETO:\n                                </label>\n                                <div class=\"flex items-center gap-4 group\" data-kid=\"1-7-1-1-2-1-2-1-2\" data-name=\"input wrapper\">\n                                    <span class=\"text-[#00FFFF] animate-pulse group-focus-within:opacity-100\" data-kid=\"1-7-1-1-2-1-2-1-2-1\" data-name=\"input prompt\">\n                                        >>\n                                    </span>\n                                    <input class=\"w-full bg-transparent border-b border-white/10 py-3 focus:border-[#00FFFF] outline-none text-white transition-colors placeholder:text-white/10\" data-kid=\"1-7-1-1-2-1-2-1-2-2\" data-name=\"text input\" placeholder=\"NOMBRE_APELLIDO\" required=\"\" type=\"text\"/>\n                                </div>\n                            </div>\n                            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"1-7-1-1-2-1-2-2\" data-name=\"form field group 2 grid\">\n                                <div class=\"space-y-2\" data-kid=\"1-7-1-1-2-1-2-2-1\" data-name=\"form field group 2a\">\n                                    <label class=\"block text-white/40 text-[10px] uppercase tracking-[0.3em] font-bold\" data-kid=\"1-7-1-1-2-1-2-2-1-1\" data-name=\"field label\">\n                                        02. EMAIL CORPORATIVO:\n                                    </label>\n                                    <div class=\"flex items-center gap-4 group\" data-kid=\"1-7-1-1-2-1-2-2-1-2\" data-name=\"input wrapper\">\n                                        <span class=\"text-[#00FFFF] animate-pulse group-focus-within:opacity-100\" data-kid=\"1-7-1-1-2-1-2-2-1-2-1\" data-name=\"input prompt\">\n                                            >>\n                                        </span>\n                                        <input class=\"w-full bg-transparent border-b border-white/10 py-3 focus:border-[#00FFFF] outline-none text-white transition-colors placeholder:text-white/10\" data-kid=\"1-7-1-1-2-