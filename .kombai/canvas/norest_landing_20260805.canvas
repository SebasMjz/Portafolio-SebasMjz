  "nodes": {
    "var_f3d8bf5e4ad3": {
      "type": "variant",
      "label": "NoRest — Soft Aurora Landing",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<div class=\"bg-[#F8F4FF] text-[#6C3082] font-['Nunito_Sans'] selection:bg-[#6C3082]/10 selection:text-[#6C3082] overflow-x-clip\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- GSAP & Plugins -->\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n    </script>\n    <script>\n        gsap.registerPlugin(ScrollTrigger);\n    </script>\n    <!-- Lenis for Smooth Scroll -->\n    <link data-kid=\"1-1\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n    <script type=\"module\">\n        import Lenis from \"https://esm.sh/lenis@1\"\n    import Snap from \"https://esm.sh/lenis@1/snap\"\n    const lenis = new Lenis()\n    function raf(time) {\n      lenis.raf(time)\n      requestAnimationFrame(raf)\n    }\n    requestAnimationFrame(raf)\n    </script>\n    <!-- Icons -->\n    <link data-kid=\"1-2\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Nunito+Sans:wght@300;400;600;700&display=swap');\n\n    :root {\n      --mist: #F8F4FF;\n      --orchid: #6C3082;\n      --pink: #FF91A4;\n      --blue: #89CFF0;\n      --pink-dark: #D46F80;\n      --blue-dark: #64A6C5;\n    }\n\n    .font-outfit { font-family: 'Outfit', sans-serif; }\n\n    /* Glassmorphism Base */\n    .glass {\n      background: rgba(255, 255, 255, 0.45);\n      backdrop-filter: blur(16px);\n      -webkit-backdrop-filter: blur(16px);\n      border: 1px solid rgba(255, 255, 255, 0.4);\n      box-shadow: 0 8px 32px 0 rgba(108, 48, 130, 0.04);\n    }\n\n    .glass-dark {\n      background: rgba(255, 255, 255, 0.6);\n      backdrop-filter: blur(20px);\n      border: 1px solid rgba(255, 255, 255, 0.5);\n    }\n\n    .glass-sculpture {\n      background: linear-gradient(135deg, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.1));\n      backdrop-filter: blur(30px);\n      border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;\n      border: 1px solid rgba(255, 255, 255, 0.2);\n    }\n\n    /* Aurora Background */\n    .aurora-container {\n      position: fixed;\n      inset: 0;\n      z-index: -2;\n      overflow: hidden;\n      background: var(--mist);\n    }\n\n    .aurora-blob {\n      position: absolute;\n      width: 80vw;\n      height: 80vw;\n      border-radius: 50%;\n      filter: blur(100px);\n      opacity: 0.5;\n    }\n\n    /* Carousel Spacing */\n    .carousel-track::-webkit-scrollbar { display: none; }\n    \n    /* FAQ Stack */\n    .faq-active {\n      transform: translateY(0) scale(1) !important;\n      z-index: 50 !important;\n      opacity: 1 !important;\n      box-shadow: 0 20px 50px -10px rgba(108, 48, 130, 0.15);\n    }\n    \n    /* Custom Scrollbar Hide */\n    .no-scrollbar::-webkit-scrollbar { display: none; }\n    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n    </style>\n    <!-- BACKGROUND ELEMENTS -->\n    <div class=\"aurora-container\" data-kid=\"1-3\" data-name=\"aurora background container\">\n        <div class=\"aurora-blob bg-[var(--blue)] -top-1/4 -left-1/4\" data-kid=\"1-3-1\" data-name=\"top-left aurora blob\">\n        </div>\n        <div class=\"aurora-blob bg-[var(--pink)] top-1/2 -right-1/4 translate-y-[-50%]\" data-kid=\"1-3-2\" data-name=\"middle-right aurora blob\">\n        </div>\n        <div class=\"aurora-blob bg-[var(--orchid)] -bottom-1/4 left-1/2 -translate-x-1/2\" data-kid=\"1-3-3\" data-name=\"bottom-center aurora blob\">\n        </div>\n        <div class=\"absolute inset-0 bg-white/30 backdrop-blur-[40px]\" data-kid=\"1-3-4\" data-name=\"overlay blur container\">\n        </div>\n    </div>\n    <!-- 1. NAVIGATION -->\n    <header class=\"fixed top-8 left-1/2 -translate-x-1/2 w-[90%] max-w-6xl glass rounded-full px-10 py-5 flex items-center justify-between z-[100]\" data-dynamic=\"true\" data-kid=\"1-4\" data-name=\"main navigation bar\" data-reason=\"vertical position and visibility toggled by scroll script\" id=\"main-nav\">\n        <a class=\"flex items-center\" data-kid=\"1-4-1\" data-name=\"brand logo link\" href=\"#\">\n            <img alt=\"NoRest Solutions Logo\" class=\"h-10 w-auto\" data-kid=\"1-4-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/norest-logo.png\"/>\n        </a>\n        <nav class=\"hidden md:flex items-center gap-10\" data-kid=\"1-4-2\" data-name=\"navigation menu links\">\n            <a class=\"text-sm font-bold hover:text-[var(--pink)]\" data-kid=\"1-4-2-1\" data-name=\"services link\" href=\"#servicios\">\n                Servicios\n            </a>\n            <a class=\"text-sm font-bold hover:text-[var(--pink)]\" data-kid=\"1-4-2-2\" data-name=\"process link\" href=\"#proceso\">\n                Proceso\n            </a>\n            <a class=\"text-sm font-bold hover:text-[var(--pink)]\" data-kid=\"1-4-2-3\" data-name=\"projects link\" href=\"#proyectos\">\n                Proyectos\n            </a>\n            <a class=\"text-sm font-bold hover:text-[var(--pink)]\" data-kid=\"1-4-2-4\" data-name=\"faq link\" href=\"#faq\">\n                FAQ\n            </a>\n        </nav>\n        <button class=\"bg-[var(--orchid)] text-white px-8 py-2.5 rounded-full text-sm font-bold hover:bg-[var(--orchid)]/90 transition-colors shadow-lg shadow-[var(--orchid)]/20 cursor-pointer\" data-kid=\"1-4-3\" data-name=\"hablemos call-to-action button\">\n            Hablemos\n        </button>\n    </header>\n    <!-- 2. HERO -->\n    <section class=\"relative min-h-screen flex items-center justify-center pt-32 overflow-hidden px-8\" data-kid=\"1-5\" data-name=\"hero section\">\n        <!-- Silk Texture Wrap -->\n        <div class=\"absolute inset-0 z-0\" data-kid=\"1-5-1\" data-name=\"silk texture container\">\n            <img alt=\"Soft abstract flowing silk texture by Milad Fakurian\" class=\"w-full h-full object-cover mix-blend-multiply opacity-20\" data-kid=\"1-5-1-1\" data-name=\"silk texture background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1634655511368-6cd7213719f4?auto=format&w=1920&q=80&fit=crop\"/>\n        </div>\n        <div class=\"relative z-10 max-w-7xl w-full grid grid-cols-1 lg:grid-cols-2 items-center gap-20\" data-kid=\"1-5-2\" data-name=\"hero content grid\">\n            <div class=\"text-left flex flex-col items-start gap-10\" data-kid=\"1-5-2-1\" data-name=\"hero content text column\" id=\"hero-content\">\n                <div class=\"hero-animate-item flex gap-4\" data-kid=\"1-5-2-1-1\" data-name=\"hero tag container\">\n                    <span class=\"glass px-5 py-2 rounded-full text-xs font-bold text-[var(--orchid)] border-white/60\" data-kid=\"1-5-2-1-1-1\" data-name=\"first hero tag\">\n                        Entrega clara\n                    </span>\n                    <span class=\"glass px-5 py-2 rounded-full text-xs font-bold text-[var(--orchid)] border-white/60\" data-kid=\"1-5-2-1-1-2\" data-name=\"second hero tag\">\n                        Acompañamiento real\n                    </span>\n                </div>\n                <h1 class=\"hero-animate-item font-outfit text-6xl md:text-8xl font-bold text-[var(--orchid)] leading-[1.0] tracking-tight\" data-kid=\"1-5-2-1-2\" data-name=\"hero headline text\">\n                    Sistemas que\n                    <br data-kid=\"1-5-2-1-2-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-transparent bg-clip-text bg-linear-to-r from-[var(--orchid)] to-[var(--pink)]\" data-kid=\"1-5-2-1-2-2\" data-name=\"animated gradient text\">\n                        fluyen\n                    </span>\n                    contigo\n                </h1>\n                <p class=\"hero-animate-item text-xl md:text-2xl text-[var(--orchid)]/70 max-w-lg leading-relaxed font-light\" data-kid=\"1-5-2-1-3\" data-name=\"hero description text\">\n                    NoRest Solutions crea software a medida que simplifica lo complejo. Web, mobile y sistemas robustos diseñados con elegancia.\n                </p>\n                <div class=\"hero-animate-item flex flex-wrap gap-5\" data-kid=\"1-5-2-1-4\" data-name=\"hero cta button container\">\n                    <button class=\"bg-[var(--orchid)] text-white px-10 py-5 rounded-full text-lg font-bold shadow-xl shadow-[var(--orchid)]/20 hover:scale-105 transition-transform cursor-pointer\" data-kid=\"1-5-2-1-4-1\" data-name=\"primary get-started button\">\n                        Cuéntanos tu idea\n                    </button>\n                    <button class=\"glass text-[var(--orchid)] px-10 py-5 rounded-full text-lg font-bold border-white/80 hover:bg-white transition-all cursor-pointer\" data-kid=\"1-5-2-1-4-2\" data-name=\"secondary view-services button\">\n                        Ver servicios\n                    </button>\n                </div>\n            </div>\n            <div class=\"relative hidden lg:block h-[600px] w-full\" data-dynamic=\"true\" data-kid=\"1-5-2-2\" data-name=\"hero visual ornament container\" data-reason=\"blur and scale animated by entrance script\" id=\"hero-visual\">\n                <div class=\"absolute inset-0 glass-sculpture animate-pulse duration-[8000ms] opacity-60\" data-kid=\"1-5-2-2-1\" data-name=\"first decorative glass shape\">\n                </div>\n                <div class=\"absolute inset-10 glass-sculpture rotate-[15deg] bg-white/10 opacity-40\" data-kid=\"1-5-2-2-2\" data-name=\"second decorative glass shape\">\n                </div>\n                <div class=\"absolute inset-20 glass-sculpture rotate-[-10deg] border-[var(--pink)]/30 opacity-30\" data-kid=\"1-5-2-2-3\" data-name=\"third decorative glass shape\">\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 3. SERVICES (Floating Islands) -->\n    <section class=\"py-32 px-8 relative overflow-hidden\" data-kid=\"1-6\" data-name=\"services section\" id=\"servicios\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-6-1\" data-name=\"services content container\">\n            <div class=\"text-center mb-24\" data-kid=\"1-6-1-1\" data-name=\"services header text\">\n                <h2 class=\"font-outfit text-5xl md:text-6xl font-bold text-[var(--orchid)] mb-6\" data-kid=\"1-6-1-1-1\" data-name=\"services title text\">\n                    Soluciones que fluyen\n                </h2>\n                <p class=\"text-xl text-[var(--orchid)]/60 max-w-xl mx-auto\" data-kid=\"1-6-1-1-2\" data-name=\"services description text\">\n                    Tecnología robusta disfrazada de simplicidad. Diseñamos para personas, construimos para el futuro.\n                </p>\n            </div>\n            <div class=\"relative min-h-[700px] w-full mt-12\" data-kid=\"1-6-1-2\" data-name=\"services cards container\">\n                <!-- Web Card -->\n                <div class=\"island-card glass absolute top-0 left-[5%] p-10 rounded-[48px] w-full max-w-sm rotate-[-2deg] z-10\" data-dynamic=\"true\" data-kid=\"1-6-1-2-1\" data-name=\"web service card\" data-reason=\"y and x position animated by bobbing script\">\n                    <div class=\"w-16 h-16 rounded-3xl bg-[var(--blue)]/20 flex items-center justify-center mb-8\" data-kid=\"1-6-1-2-1-1\" data-name=\"web service icon container\">\n                        <i class=\"ti ti-layout text-3xl text-[var(--orchid)]\" data-kid=\"1-6-1-2-1-1-1\" data-name=\"web icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-outfit text-3xl font-bold text-[var(--orchid)] mb-4\" data-kid=\"1-6-1-2-1-2\" data-name=\"web service title\">\n                        Web\n                    </h3>\n                    <p class=\"text-[var(--orchid)]/70 leading-relaxed text-lg\" data-kid=\"1-6-1-2-1-3\" data-name=\"web service description\">\n                        Ecosistemas digitales que priorizan la velocidad, la seguridad y una experiencia de usuario sin fricciones.\n                    </p>\n                </div>\n                <!-- Mobile Card -->\n                <div class=\"island-card glass-dark absolute top-[80px] right-[5%] p-12 rounded-[56px] w-full max-w-md rotate-[3deg] z-20\" data-dynamic=\"true\" data-kid=\"1-6-1-2-2\" data-name=\"mobile service card\" data-reason=\"y and x position animated by bobbing script\">\n                    <div class=\"w-20 h-20 rounded-[32px] bg-[var(--pink)]/20 flex items-center justify-center mb-10\" data-kid=\"1-6-1-2-2-1\" data-name=\"mobile service icon container\">\n                        <i class=\"ti ti-device-mobile text-4xl text-[var(--orchid)]\" data-kid=\"1-6-1-2-2-1-1\" data-name=\"mobile icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-outfit text-4xl font-bold text-[var(--orchid)] mb-5\" data-kid=\"1-6-1-2-2-2\" data-name=\"mobile service title\">\n                        Apps móviles\n                    </h3>\n                    <p class=\"text-[var(--orchid)]/70 leading-relaxed text-xl font-light\" data-kid=\"1-6-1-2-2-3\" data-name=\"mobile service description\">\n                        Aplicaciones nativas e híbridas diseñadas para ser la herramienta favorita de tus clientes, en cualquier dispositivo.\n                    </p>\n                </div>\n                <!-- Desktop Card -->\n                <div class=\"island-card glass absolute bottom-[100px] left-[15%] p-10 rounded-[50px] w-full max-w-sm rotate-[-4deg] z-10\" data-dynamic=\"true\" data-kid=\"1-6-1-2-3\" data-name=\"desktop service card\" data-reason=\"y and x position animated by bobbing script\">\n                    <div class=\"w-16 h-16 rounded-3xl bg-[var(--orchid)]/10 flex items-center justify-center mb-8\" data-kid=\"1-6-1-2-3-1\" data-name=\"desktop service icon container\">\n                        <i class=\"ti ti-device-desktop-code text-3xl text-[var(--orchid)]\" data-kid=\"1-6-1-2-3-1-1\" data-name=\"desktop icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-outfit text-3xl font-bold text-[var(--orchid)] mb-4\" data-kid=\"1-6-1-2-3-2\" data-name=\"desktop service title\">\n                        Escritorio\n                    </h3>\n                    <p class=\"text-[var(--orchid)]/70 leading-relaxed text-lg\" data-kid=\"1-6-1-2-3-3\" data-name=\"desktop service description\">\n                        Software de alto rendimiento para Windows y macOS, optimizado para flujos de trabajo profesionales complejos.\n                    </p>\n                </div>\n                <!-- Custom Card -->\n                <div class=\"island-card glass absolute bottom-0 right-[20%] p-12 rounded-[60px] w-full max-w-lg rotate-[1deg] z-10\" data-dynamic=\"true\" data-kid=\"1-6-1-2-4\" data-name=\"custom service card\" data-reason=\"y and x position animated by bobbing script\">\n                    <div class=\"w-20 h-20 rounded-[32px] bg-[var(--blue)]/20 flex items-center justify-center mb-10\" data-kid=\"1-6-1-2-4-1\" data-name=\"custom service icon container\">\n                        <i class=\"ti ti-code text-4xl text-[var(--orchid)]\" data-kid=\"1-6-1-2-4-1-1\" data-name=\"custom code icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-outfit text-4xl font-bold text-[var(--orchid)] mb-5\" data-kid=\"1-6-1-2-4-2\" data-name=\"custom service title\">\n                        Sistemas a medida\n                    </h3>\n                    <p class=\"text-[var(--orchid)]/70 leading-relaxed text-xl font-light\" data-kid=\"1-6-1-2-4-3\" data-name=\"custom service description\">\n                        Cuando el software comercial se queda corto, construimos la infraestructura que tu empresa realmente necesita.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 4. PROCESS (Timeline) -->\n    <section class=\"py-40 bg-white/40 backdrop-blur-3xl relative overflow-hidden\" data-kid=\"1-7\" data-name=\"process timeline section\" id=\"proceso\">\n        <div class=\"max-w-5xl mx-auto px-8\" data-kid=\"1-7-1\" data-name=\"timeline content container\">\n            <div class=\"text-center mb-32\" data-kid=\"1-7-1-1\" data-name=\"timeline header text\">\n                <h2 class=\"font-outfit text-5xl md:text-6xl font-bold text-[var(--orchid)] mb-6\" data-kid=\"1-7-1-1-1\" data-name=\"timeline title text\">\n                    Cómo lo hacemos realidad\n                </h2>\n                <p class=\"text-xl text-[var(--orchid)]/60\" data-kid=\"1-7-1-1-2\" data-name=\"timeline description text\">\n                    Un camino claro desde la primera idea hasta el lanzamiento global.\n                </p>\n            </div>\n            <div class=\"relative\" data-kid=\"1-7-1-2\" data-name=\"timeline steps container\">\n                <!-- SVG Path for Timeline -->\n                <div class=\"absolute left-1/2 top-0 bottom-0 -translate-x-1/2 w-px bg-[var(--orchid)]/20\" data-kid=\"1-7-1-2-1\" data-name=\"timeline track line container\">\n                    <svg class=\"w-1 h-full\" data-dynamic=\"true\" data-kid=\"1-7-1-2-1-1\" data-name=\"timeline track svg\" data-reason=\"stroke-dashoffset animated by scroll script\" overflow=\"visible\">\n                        <line id=\"timeline-svg-line\" stroke=\"var(--orchid)\" stroke-dasharray=\"8 8\" stroke-width=\"4\" x1=\"2\" x2=\"2\" y1=\"0\" y2=\"100%\">\n                        </line>\n                    </svg>\n                </div>\n                <!-- Step 1 -->\n                <div class=\"timeline-step flex items-center justify-between mb-24 relative\" data-kid=\"1-7-1-2-2\" data-name=\"first process step\">\n                    <div class=\"w-[42%] text-right pr-12\" data-kid=\"1-7-1-2-2-1\" data-name=\"step content container\">\n                        <span class=\"text-[var(--pink-dark)] font-bold tracking-[0.2em] text-xs uppercase block mb-3\" data-kid=\"1-7-1-2-2-1-1\" data-name=\"step phase title\">\n                            01. Fase Inicial\n                        </span>\n                        <h3 class=\"font-outfit text-4xl font-bold text-[var(--orchid)] mb-4\" data-kid=\"1-7-1-2-2-1-2\" data-name=\"step title text\">\n                            Descubrimos\n                        </h3>\n                        <p class=\"text-[var(--orchid)]/70 text-lg leading-relaxed\" data-kid=\"1-7-1-2-2-1-3\" data-name=\"step description text\">\n                            Analizamos tu modelo de negocio y desafíos para encontrar la solución técnica más eficiente y escalable.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot-container relative z-10 flex items-center justify-center shrink-0\" data-kid=\"1-7-1-2-2-2\" data-name=\"step marker container\">\n                        <div class=\"w-12 h-px bg-[var(--orchid)] absolute right-full opacity-20\" data-kid=\"1-7-1-2-2-2-1\" data-name=\"step connector line\">\n                        </div>\n                        <div class=\"w-6 h-6 rounded-full bg-[var(--orchid)] border-8 border-[var(--mist)] shadow-lg shadow-[var(--orchid)]/30\" data-kid=\"1-7-1-2-2-2-2\" data-name=\"step dot marker\">\n                        </div>\n                    </div>\n                    <div class=\"w-[42%] pl-12\" data-kid=\"1-7-1-2-2-3\" data-name=\"empty step spacer\">\n                    </div>\n                </div>\n                <!-- Step 2 -->\n                <div class=\"timeline-step flex items-center flex-row-reverse justify-between mb-24 relative\" data-kid=\"1-7-1-2-3\" data-name=\"second process step\">\n                    <div class=\"w-[42%] text-left pl-12\" data-kid=\"1-7-1-2-3-1\" data-name=\"step content container\">\n                        <span class=\"text-[var(--blue-dark)] font-bold tracking-[0.2em] text-xs uppercase block mb-3\" data-kid=\"1-7-1-2-3-1-1\" data-name=\"step phase title\">\n                            02. Diseño UX/UI\n                        </span>\n                        <h3 class=\"font-outfit text-4xl font-bold text-[var(--orchid)] mb-4\" data-kid=\"1-7-1-2-3-1-2\" data-name=\"step title text\">\n                            Diseñamos\n                        </h3>\n                        <p class=\"text-[var(--orchid)]/70 text-lg leading-relaxed\" data-kid=\"1-7-1-2-3-1-3\" data-name=\"step description text\">\n                            Creamos interfaces fluidas que tus usuarios amarán. Estética y funcionalidad trabajando en perfecta armonía.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot-container relative z-10 flex items-center justify-center shrink-0\" data-kid=\"1-7-1-2-3-2\" data-name=\"step marker container\">\n                        <div class=\"w-12 h-px bg-[var(--blue-dark)] absolute left-full opacity-20\" data-kid=\"1-7-1-2-3-2-1\" data-name=\"step connector line\">\n                        </div>\n                        <div class=\"w-6 h-6 rounded-full bg-[var(--blue-dark)] border-8 border-[var(--mist)] shadow-lg shadow-[var(--blue)]/30\" data-kid=\"1-7-1-2-3-2-2\" data-name=\"step dot marker\">\n                        </div>\n                    </div>\n                    <div class=\"w-[42%] pr-12\" data-kid=\"1-7-1-2-3-3\" data-name=\"empty step spacer\">\n                    </div>\n                </div>\n                <!-- Step 3 -->\n                <div class=\"timeline-step flex items-center justify-between mb-24 relative\" data-kid=\"1-7-1-2-4\" data-name=\"third process step\">\n                    <div class=\"w-[42%] text-right pr-12\" data-kid=\"1-7-1-2-4-1\" data-name=\"step content container\">\n                        <span class=\"text-[var(--orchid)] font-bold tracking-[0.2em] text-xs uppercase block mb-3\" data-kid=\"1-7-1-2-4-1-1\" data-name=\"step phase title\">\n                            03. Desarrollo\n                        </span>\n                        <h3 class=\"font-outfit text-4xl font-bold text-[var(--orchid)] mb-4\" data-kid=\"1-7-1-2-4-1-2\" data-name=\"step title text\">\n                            Construimos\n                        </h3>\n                        <p class=\"text-[var(--orchid)]/70 text-lg leading-relaxed\" data-kid=\"1-7-1-2-4-1-3\" data-name=\"step description text\">\n                            Código limpio, robusto y probado. Utilizamos las tecnologías más modernas para garantizar longevidad.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot-container relative z-10 flex items-center justify-center\" data-kid=\"1-7-1-2-4-2\" data-name=\"step marker container\">\n                        <div class=\"w-12 h-px bg-[var(--orchid)] absolute right-full opacity-20\" data-kid=\"1-7-1-2-4-2-1\" data-name=\"step connector line\">\n                        </div>\n                        <div class=\"w-6 h-6 rounded-full bg-[var(--orchid)] border-8 border-[var(--mist)] shadow-lg shadow-[var(--orchid)]/30\" data-kid=\"1-7-1-2-4-2-2\" data-name=\"step dot marker\">\n                        </div>\n                    </div>\n                    <div class=\"w-[42%] pl-12\" data-kid=\"1-7-1-2-4-3\" data-name=\"empty step spacer\">\n                    </div>\n                </div>\n                <!-- Step 4 -->\n                <div class=\"timeline-step flex items-center flex-row-reverse justify-between relative\" data-kid=\"1-7-1-2-5\" data-name=\"fourth process step\">\n                    <div class=\"w-[42%] text-left pl-12\" data-kid=\"1-7-1-2-5-1\" data-name=\"step content container\">\n                        <span class=\"text-[var(--pink-dark)] font-bold tracking-[0.2em] text-xs uppercase block mb-3\" data-kid=\"1-7-1-2-5-1-1\" data-name=\"step phase title\">\n                            04. Despliegue\n                        </span>\n                        <h3 class=\"font-outfit text-4xl font-bold text-[var(--orchid)] mb-4\" data-kid=\"1-7-1-2-5-1-2\" data-name=\"step title text\">\n                            Lanzamos\n                        </h3>\n                        <p class=\"text-[var(--orchid)]/70 text-lg leading-relaxed\" data-kid=\"1-7-1-2-5-1-3\" data-name=\"step description text\">\n                            Te acompañamos en el lanzamiento y escalado inicial, asegurando que todo funcione como un reloj suizo.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot-container relative z-10 flex items-center justify-center\" data-kid=\"1-7-1-2-5-2\" data-name=\"step marker container\">\n                        <div class=\"w-12 h-px bg-[var(--pink-dark)] absolute left-full opacity-20\" data-kid=\"1-7-1-2-5-2-1\" data-name=\"step connector line\">\n                        </div>\n                        <div class=\"w-6 h-6 rounded-full bg-[var(--pink-dark)] border-8 border-[var(--mist)] shadow-lg shadow-[var(--pink)]/30\" data-kid=\"1-7-1-2-5-2-2\" data-name=\"step dot marker\">\n                        </div>\n                    </div>\n                    <div class=\"w-[42%] pr-12\" data-kid=\"1-7-1-2-5-3\" data-name=\"empty step spacer\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 5. CASE STUDIES (Carousel) -->\n    <section class=\"py-40 px-8\" data-kid=\"1-8\" data-name=\"projects carousel section\" id=\"proyectos\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-8-1\" data-name=\"carousel content container\">\n            <div class=\"flex items-end justify-between mb-20\" data-kid=\"1-8-1-1\" data-name=\"carousel header area\">\n                <div class=\"max-w-2xl\" data-kid=\"1-8-1-1-1\" data-name=\"carousel title container\">\n                    <h2 class=\"font-outfit text-5xl md:text-6xl font-bold text-[var(--orchid)] mb-6\" data-kid=\"1-8-1-1-1-1\" data-name=\"carousel title text\">\n                        Casos que inspiran\n                    </h2>\n                    <p class=\"text-xl text-[var(--orchid)]/60\" data-kid=\"1-8-1-1-1-2\" data-name=\"carousel description text\">\n                        Historias de éxito construidas con paciencia y precisión.\n                    </p>\n                </div>\n                <div class=\"flex gap-4 mb-4\" data-kid=\"1-8-1-1-2\" data-name=\"carousel navigation controls\">\n                    <button class=\"w-16 h-16 rounded-full glass flex items-center justify-center hover:bg-white transition-colors cursor-pointer text-2xl\" data-kid=\"1-8-1-1-2-1\" data-name=\"previous button\" id=\"prev-btn\">\n                        <i class=\"ti ti-arrow-left\" data-kid=\"1-8-1-1-2-1-1\" data-name=\"previous arrow icon\">\n                        </i>\n                    </button>\n                    <button class=\"w-16 h-16 rounded-full glass flex items-center justify-center hover:bg-white transition-colors cursor-pointer text-2xl\" data-kid=\"1-8-1-1-2-2\" data-name=\"next button\" id=\"next-btn\">\n                        <i class=\"ti ti-arrow-right\" data-kid=\"1-8-1-1-2-2-1\" data-name=\"next arrow icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"carousel-track flex gap-8 overflow-x-auto snap-x snap-mandatory py-10 no-scrollbar\" data-kid=\"1-8-1-2\" data-name=\"projects track\" id=\"case-studies-carousel\">\n                <!-- Project 1 -->\n                <div class=\"carousel-item snap-center shrink-0 w-[800px] h-[500px] glass-dark rounded-[60px] relative overflow-hidden transition-all duration-500\" data-kid=\"1-8-1-2-1\" data-name=\"first project card\">\n                    <img alt=\"Clean minimal desk setup by Leone Venter\" class=\"w-full h-full object-cover\" data-kid=\"1-8-1-2-1-1\" data-name=\"project thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1518655048521-f130df041f66?auto=format&w=1200&q=80&fit=crop\"/>\n                    <div class=\"absolute inset-0 bg-linear-to-t from-[var(--orchid)]/60 to-transparent\" data-kid=\"1-8-1-2-1-2\" data-name=\"card overlay gradient\">\n                    </div>\n                    <div class=\"absolute bottom-8 left-8 right-8 glass p-10 rounded-[40px] flex items-center justify-between\" data-kid=\"1-8-1-2-1-3\" data-name=\"card content container\">\n                        <div data-kid=\"1-8-1-2-1-3-1\" data-name=\"project title and description area\">\n                            <h3 class=\"font-outfit text-3xl font-bold text-[var(--orchid)] mb-2\" data-kid=\"1-8-1-2-1-3-1-1\" data-name=\"project title\">\n                                FinTech Core 2.0\n                            </h3>\n                            <p class=\"text-[var(--orchid)]/80 italic text-lg leading-snug\" data-kid=\"1-8-1-2-1-3-1-2\" data-name=\"project quote\">\n                                \"Un cambio radical en nuestra operatividad diaria.\"\n                            </p>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"1-8-1-2-1-3-2\" data-name=\"project metric container\">\n                            <span class=\"block text-4xl font-bold text-[var(--orchid)]\" data-kid=\"1-8-1-2-1-3-2-1\" data-name=\"metric value text\">\n                                +68%\n                            </span>\n                            <span class=\"text-xs uppercase font-bold tracking-widest text-[var(--orchid)]/60\" data-kid=\"1-8-1-2-1-3-2-2\" data-name=\"metric label text\">\n                                Eficiencia\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Project 2 -->\n                <div class=\"carousel-item snap-center shrink-0 w-[800px] h-[500px] glass-dark rounded-[60px] relative overflow-hidden transition-all duration-500\" data-kid=\"1-8-1-2-2\" data-name=\"second project card\">\n                    <img alt=\"Hands coding on keyboard by Dan Dennis\" class=\"w-full h-full object-cover\" data-kid=\"1-8-1-2-2-1\" data-name=\"project thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1590092783103-4d397cc59375?auto=format&w=1200&q=80&fit=crop\"/>\n                    <div class=\"absolute inset-0 bg-linear-to-t from-[var(--orchid)]/60 to-transparent\" data-kid=\"1-8-1-2-2-2\" data-name=\"card overlay gradient\">\n                    </div>\n                    <div class=\"absolute bottom-8 left-8 right-8 glass p-10 rounded-[40px] flex items-center justify-between\" data-kid=\"1-8-1-2-2-3\" data-name=\"card content container\">\n                        <div data-kid=\"1-8-1-2-2-3-1\" data-name=\"project title and description area\">\n                            <h3 class=\"font-outfit text-3xl font-bold text-[var(--orchid)] mb-2\" data-kid=\"1-8-1-2-2-3-1-1\" data-name=\"project title\">\n                                HealthTrack Pro\n                            </h3>\n                            <p class=\"text-[var(--orchid)]/80 italic text-lg leading-snug\" data-kid=\"1-8-1-2-2-3-1-2\" data-name=\"project quote\">\n                                \"La UI más intuitiva que hemos implementado jamás.\"\n                            </p>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"1-8-1-2-2-3-2\" data-name=\"project metric container\">\n                            <span class=\"block text-4xl font-bold text-[var(--orchid)]\" data-kid=\"1-8-1-2-2-3-2-1\" data-name=\"metric value text\">\n                                2.5M\n                            </span>\n                            <span class=\"text-xs uppercase font-bold tracking-widest text-[var(--orchid)]/60\" data-kid=\"1-8-1-2-2-3-2-2\" data-name=\"metric label text\">\n                                Pacientes\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Project 3 -->\n                <div class=\"carousel-item snap-center shrink-0 w-[800px] h-[500px] glass-dark rounded-[60px] relative overflow-hidden transition-all duration-500\" data-kid=\"1-8-1-2-3\" data-name=\"third project card\">\n                    <img alt=\"Monitor and keyboard setup by Zarak Khan\" class=\"w-full h-full object-cover\" data-kid=\"1-8-1-2-3-1\" data-name=\"project thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1570993492881-25240ce854f4?auto=format&w=1200&q=80&fit=crop\"/>\n                    <div class=\"absolute inset-0 bg-linear-to-t from-[var(--orchid)]/60 to-transparent\" data-kid=\"1-8-1-2-3-2\" data-name=\"card overlay gradient\">\n                    </div>\n                    <div class=\"absolute bottom-8 left-8 right-8 glass p-10 rounded-[40px] flex items-center justify-between\" data-kid=\"1-8-1-2-3-3\" data-name=\"card content container\">\n                        <div data-kid=\"1-8-1-2-3-3-1\" data-name=\"project title and description area\">\n                            <h3 class=\"font-outfit text-3xl font-bold text-[var(--orchid)] mb-2\" data-kid=\"1-8-1-2-3-3-1-1\" data-name=\"project title\">\n                                EduNexus Cloud\n                            </h3>\n                            <p class=\"text-[var(--orchid)]/80 italic text-lg leading-snug\" data-kid=\"1-8-1-2-3-3-1-2\" data-name=\"project quote\">\n                                \"Escalamos a 50 países sin una sola caída.\"\n                            </p>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"1-8-1-2-3-3-2\" data-name=\"project metric container\">\n                            <span class=\"block text-4xl font-bold text-[var(--orchid)]\" data-kid=\"1-8-1-2-3-3-2-1\" data-name=\"metric value text\">\n                                99.9%\n                            </span>\n                            <span class=\"text-xs uppercase font-bold tracking-widest text-[var(--orchid)]/60\" data-kid=\"1-8-1-2-3-3-2-2\" data-name=\"metric label text\">\n                                Uptime\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 6. FAQ (Tabbed Cards) -->\n    <section class=\"py-40 px-8 relative overflow-hidden\" data-kid=\"1-9\" data-name=\"faq section\" id=\"faq\">\n        <div class=\"max-w-4xl mx-auto text-center mb-24\" data-kid=\"1-9-1\" data-name=\"faq content header\">\n            <h2 class=\"font-outfit text-5xl md:text-6xl font-bold text-[var(--orchid)] mb-8\" data-kid=\"1-9-1-1\" data-name=\"faq title text\">\n                Dudas frecuentes\n            </h2>\n            <p class=\"text-xl text-[var(--orchid)]/60\" data-kid=\"1-9-1-2\" data-name=\"faq description text\">\n                Claridad desde el primer momento.\n            </p>\n        </div>\n        <div class=\"relative h-[480px] max-w-2xl mx-auto\" data-kid=\"1-9-2\" data-name=\"faq cards stack container\" id=\"faq-stack-container\">\n            <!-- Q1 -->\n            <div class=\"faq-card absolute top-0 left-0 w-full glass p-10 rounded-[48px] cursor-pointer z-40 faq-active\" data-dynamic=\"true\" data-index=\"0\" data-kid=\"1-9-2-1\" data-name=\"first faq card\" data-reason=\"y, scale, opacity, and answer height animated by script\">\n                <h4 class=\"font-outfit text-2xl font-bold text-[var(--orchid)] mb-6\" data-kid=\"1-9-2-1-1\" data-name=\"faq question title\">\n                    ¿Cuánto tiempo toma desarrollar un sistema?\n                </h4>\n                <div class=\"faq-answer overflow-hidden\" data-kid=\"1-9-2-1-2\" data-name=\"faq answer content container\">\n                    <p class=\"text-lg text-[var(--orchid)]/70 leading-relaxed\" data-kid=\"1-9-2-1-2-1\" data-name=\"faq answer text\">\n                        Cada proyecto es único. Un MVP (Producto Mínimo Viable) suele tomar entre 8 y 12 semanas. Un sistema complejo puede extenderse de 4 a 6 meses. Siempre priorizamos la calidad sobre las prisas.\n                    </p>\n                </div>\n            </div>\n            <!-- Q2 -->\n            <div class=\"faq-card absolute top-[100px] left-0 w-full glass p-10 rounded-[48px] cursor-pointer z-30 opacity-0 scale-[0.96]\" data-dynamic=\"true\" data-index=\"1\" data-kid=\"1-9-2-2\" data-name=\"second faq card\" data-reason=\"y, scale, opacity, and answer height animated by script\">\n                <h4 class=\"font-outfit text-2xl font-bold text-[var(--orchid)] mb-6\" data-kid=\"1-9-2-2-1\" data-name=\"faq question title\">\n                    ¿Ofrecen soporte post-lanzamiento?\n                </h4>\n                <div class=\"faq-answer h-0 overflow-hidden\" data-dynamic=\"true\" data-kid=\"1-9-2-2-2\" data-name=\"faq answer content container\" data-reason=\"height and opacity controlled by script\">\n                    <p class=\"text-lg text-[var(--orchid)]/70 leading-relaxed\" data-kid=\"1-9-2-2-2-1\" data-name=\"faq answer text\">\n                        Absolutamente. NoRest Solutions no solo construye y se va. Ofrecemos planes de mantenimiento evolutivo, monitoreo 24/7 y actualizaciones de seguridad constantes para que tu sistema nunca se detenga.\n                    </p>\n                </div>\n            </div>\n            <!-- Q3 -->\n            <div class=\"faq-card absolute top-[200px] left-0 w-full glass p-10 rounded-[48px] cursor-pointer z-20 opacity-0 scale-[0.92]\" data-dynamic=\"true\" data-index=\"2\" data-kid=\"1-9-2-3\" data-name=\"third faq card\" data-reason=\"y, scale, opacity, and answer height animated by script\">\n                <h4 class=\"font-outfit text-2xl font-bold text-[var(--orchid)] mb-6\" data-kid=\"1-9-2-3-1\" data-name=\"faq question title\">\n                    ¿Puedo migrar mi sistema actual con ustedes?\n                </h4>\n                <div class=\"faq-answer h-0 overflow-hidden\" data-dynamic=\"true\" data-kid=\"1-9-2-3-2\" data-name=\"faq answer content container\" data-reason=\"height and opacity controlled by script\">\n                    <p class=\"text-lg text-[var(--orchid)]/70 leading-relaxed\" data-kid=\"1-9-2-3-2-1\" data-name=\"faq answer text\">\n                        Sí, somos expertos en modernización de software. Analizamos tu código base actual, identificamos cuellos de botella y trazamos una estrategia de migración segura y sin pérdida de datos.\n                    </p>\n                </div>\n            </div>\n            <!-- Q4 -->\n            <div class=\"faq-card absolute top-[300px] left-0 w-full glass p-10 rounded-[48px] cursor-pointer z-10 opacity-0 scale-[0.88]\" data-dynamic=\"true\" data-index=\"3\" data-kid=\"1-9-2-4\" data-name=\"fourth faq card\" data-reason=\"y, scale, opacity, and answer height animated by script\">\n                <h4 class=\"font-outfit text-2xl font-bold text-[var(--orchid)] mb-6\" data-kid=\"1-9-2-4-1\" data-name=\"faq question title\">\n                    ¿Cómo manejamos la propiedad intelectual?\n                </h4>\n                <div class=\"faq-answer h-0 overflow-hidden\" data-dynamic=\"true\" data-kid=\"1-9-2-4-2\" data-name=\"faq answer content container\" data-reason=\"height and opacity controlled by script\">\n                    <p class=\"text-lg text-[var(--orchid)]/70 leading-relaxed\" data-kid=\"1-9-2-4-2-1\" data-name=\"faq answer text\">\n                        La transparencia es clave. Todo el código fuente, bases de datos y propiedad intelectual del sistema desarrollado pertenecen 100% al cliente una vez finalizado el proyecto.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 7. CONTACT -->\n    <section class=\"py-40 px-8 relative\" data-kid=\"1-10\" data-name=\"contact section\">\n        <!-- Background Mesh -->\n        <div class=\"absolute inset-0 z-0 bg-linear-to-br from-[var(--blue)]/10 via-[var(--mist)] to-[var(--pink)]/10\" data-kid=\"1-10-1\" data-name=\"contact background mesh\">\n        </div>\n        <div class=\"relative z-10 glass-dark rounded-[70px] p-12 md:p-24 max-w-4xl mx-auto\" data-kid=\"1-10-2\" data-name=\"contact form container\" id=\"contact-form-card\">\n            <div class=\"text-center mb-16\" data-kid=\"1-10-2-1\" data-name=\"contact header text\">\n                <h2 class=\"font-outfit text-5xl font-bold text-[var(--orchid)] mb-6\" data-kid=\"1-10-2-1-1\" data-name=\"contact title\">\n                    Construyamos el futuro\n                </h2>\n                <p class=\"text-xl text-[var(--orchid)]/60\" data-kid=\"1-10-2-1-2\" data-name=\"contact description\">\n                    Déjanos tus datos y nos pondremos en contacto en menos de 24 horas.\n                </p>\n            </div>\n            <form class=\"space-y-8\" data-kid=\"1-10-2-2\" data-name=\"contact form\">\n                <div class=\"grid md:grid-cols-2 gap-8\" data-kid=\"1-10-2-2-1\" data-name=\"form row grid\">\n                    <div class=\"space-y-3\" data-kid=\"1-10-2-2-1-1\" data-name=\"name field container\">\n                        <label class=\"text-xs font-bold tracking-widest text-[var(--orchid)] uppercase ml-5\" data-kid=\"1-10-2-2-1-1-1\" data-name=\"name label\">\n                            Nombre\n                        </label>\n                        <input class=\"w-full glass bg-white/50 rounded-full px-8 py-5 border-white/60 focus:bg-white focus:border-[var(--orchid)] transition-all outline-none text-lg\" data-kid=\"1-10-2-2-1-1-2\" data-name=\"name input\" placeholder=\"Tu nombre completo\" type=\"text\"/>\n                    </div>\n                    <div class=\"space-y-3\" data-kid=\"1-10-2-2-1-2\" data-name=\"email field container\">\n                        <label class=\"text-xs font-bold tracking-widest text-[var(--orchid)] uppercase ml-5\" data-kid=\"1-10-2-2-1-2-1\" data-name=\"email label\">\n                            Email\n                        </label>\n                        <input class=\"w-full glass bg-white/50 rounded-full px-8 py-5 border-white/60 focus:bg-white focus:border-[var(--orchid)] transition-all outline-none text-lg\" data-kid=\"1-10-2-2-1-2-2\" data-name=\"email input\" placeholder=\"hola@tuempresa.com\" type=\"email\"/>\n                    </div>\n                </div>\n                <div class=\"space-y-3\" data-kid=\"1-10-2-2-2\" data-name=\"service select field container\">\n                    <label class=\"text-xs font-bold tracking-widest text-[var(--orchid)] uppercase ml-5\" data-kid=\"1-10-2-2-2-1\" data-name=\"service select label\">\n                        Servicio Interés\n                    </label>\n                    <div class=\"relative\" data-kid=\"1-10-2-2-2-2\" data-name=\"select input container\">\n                        <select class=\"w-full glass bg-white/50 rounded-full px-8 py-5 border-white/60 focus:bg-white focus:border-[var(--orchid)] transition-all outline-none text-lg appearance-none cursor-pointer\" data-kid=\"1-10-2-2-2-2-1\" data-name=\"service dropdown\">\n                            <option data-kid=\"1-10-2-2-2-2-1-1\" data-name=\"web development option\">\n                                Desarrollo Web\n                            </option>\n                            <option data-kid=\"1-10-2-2-2-2-1-2\" data-name=\"mobile apps option\">\n                                Apps Móviles\n                            </option>\n                            <option data-kid=\"1-10-2-2-2-2-1-3\" data-name=\"bespoke systems option\">\n                                Sistemas a Medida\n                            </option>\n                            <option data-kid=\"1-10-2-2-2-2-1-4\" data-name=\"it consulting option\">\n                                Consultoría IT\n                            </option>\n                        </select>\n                        <i class=\"ti ti-chevron-down absolute right-8 top-1/2 -translate-y-1/2 text-[var(--orchid)] pointer-events-none\" data-kid=\"1-10-2-2-2-2-2\" data-name=\"select dropdown icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"space-y-3\" data-kid=\"1-10-2-2-3\" data-name=\"message field container\">\n                    <label class=\"text-xs font-bold tracking-widest text-[var(--orchid)] uppercase ml-5\" data-kid=\"1-10-2-2-3-1\" data-name=\"message label\">\n                        Mensaje\n                    </label>\n                    <textarea class=\"w-full glass bg-white/50 rounded-[40px] px-8 py-6 border-white/60 focus:bg-white focus:border-[var(--orchid)] transition-all outline-none text-lg min-h-[180px] resize-none\" data-kid=\"1-10-2-2-3-2\" data-name=\"message textarea\" placeholder=\"Cuéntanos un poco sobre tu visión...\"></textarea>\n                </div>\n                <button class=\"w-full bg-linear-to-r from-[var(--orchid)] to-[var(--pink)] text-white py-6 rounded-full text-xl font-bold hover:scale-[1.02] active:scale-[0.98] transition-transform shadow-2xl shadow-[var(--orchid)]/20 cursor-pointer\" data-kid=\"1-10-2-2-4\" data-name=\"submit button\">\n                    Enviar mensaje\n                </button>\n            </form>\n        </div>\n    </section>\n    <!-- 8. FOOTER -->\n    <footer class=\"py-12 px-8 flex justify-center\" data-kid=\"1-11\" data-name=\"footer section\">\n        <div class=\"w-full max-w-6xl glass rounded-full px-12 py-10 flex flex-col md:flex-row items-center justify-between gap-8 md:gap-0\" data-kid=\"1-11-1\" data-name=\"footer container\" id=\"footer-bar\">\n            <div class=\"flex items-center gap-12\" data-kid=\"1-11-1-1\" data-name=\"footer navigation section\">\n                <a data-kid=\"1-11-1-1-1\" data-name=\"footer logo link\" href=\"#\">\n                    <img alt=\"NoRest Logo\" class=\"h-8\" data-kid=\"1-11-1-1-1-1\" data-name=\"footer logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/norest-logo.png\"/>\n                </a>\n                <div class=\"hidden md:flex gap-8 text-sm font-bold text-[var(--orchid)]/60\" data-kid=\"1-11-1-1-2\" data-name=\"footer policy links\">\n                    <a class=\"hover:text-[var(--orchid)]\" data-kid=\"1-11-1-1-2-1\" data-name=\"legal notice link\" href=\"#\">\n                        Aviso Legal\n                    </a>\n                    <a class=\"hover:text-[var(--orchid)]\" data-kid=\"1-11-1-1-2-2\" data-name=\"privacy link\" href=\"#\">\n                        Privacidad\n                    </a>\n                    <a class=\"hover:text-[var(--orchid)]\" data-kid=\"1-11-1-1-2-3\" data-name=\"cookies link\" href=\"#\">\n                        Cookies\n                    </a>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-11-1-2\" data-name=\"footer social and copyright section\">\n                <div class=\"flex gap-4\" data-kid=\"1-11-1-2-1\" data-name=\"social media buttons container\">\n                    <button class=\"w-10 h-10 rounded-full glass flex items-center justify-center text-[var(--orchid)] hover:bg-[var(--orchid)] hover:text-white transition-all cursor-pointer group\" data-kid=\"1-11-1-2-1-1\" data-name=\"linkedin button\" title=\"LinkedIn\">\n                        <i class=\"ti ti-brand-linkedin\" data-kid=\"1-11-1-2-1-1-1\" data-name=\"linkedin icon\">\n                        </i>\n                    </button>\n                    <button class=\"w-10 h-10 rounded-full glass flex items-center justify-center text-[var(--orchid)] hover:bg-[var(--orchid)] hover:text-white transition-all cursor-pointer group\" data-kid=\"1-11-1-2-1-2\" data-name=\"instagram button\" title=\"Instagram\">\n                        <i class=\"ti ti-brand-instagram\" data-kid=\"1-11-1-2-1-2-1\" data-name=\"instagram icon\">\n                        </i>\n                    </button>\n                    <button class=\"w-10 h-10 rounded-full glass flex items-center justify-center text-[var(--orchid)] hover:bg-[var(--orchid)] hover:text-white transition-all cursor-pointer group\" data-kid=\"1-11-1-2-1-3\" data-name=\"twitter button\" title=\"Twitter\">\n                        <i class=\"ti ti-brand-x\" data-kid=\"1-11-1-2-1-3-1\" data-name=\"twitter icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"h-6 w-px bg-[var(--orchid)]/20 hidden md:block\" data-kid=\"1-11-1-2-2\" data-name=\"divider line\">\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-11-1-2-3\" data-name=\"copyright section\">\n                    <span class=\"text-sm font-bold text-[var(--orchid)]/60\" data-kid=\"1-11-1-2-3-1\" data-name=\"copyright notice text\">\n                        © 2026 NoRest\n                    </span>\n                </div>\n            </div>\n        </div>\n    </footer>\n    <!-- ANIMATIONS SCRIPTS -->\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n      // 1. Hero Entrance\n      gsap.from(\".hero-animate-item\", {\n        autoAlpha: 0,\n        x: -50,\n        stagger: 0.2,\n        duration: 1.2,\n        ease: \"power3.out\"\n      });\n      gsap.from(\"#hero-visual\", {\n        autoAlpha: 0,\n        scale: 0.8,\n        filter: \"blur(20px)\",\n        duration: 2,\n        ease: \"expo.out\",\n        delay: 0.5\n      });\n\n      // 2. Navigation Reveal\n      gsap.from(\"#main-nav\", {\n        y: -100,\n        autoAlpha: 0,\n        duration: 1,\n        ease: \"expo.out\",\n        delay: 0.8\n      });\n\n      // 3. Floating Islands Bobbing\n      document.querySelectorAll('.island-card').forEach((card, i) => {\n        gsap.to(card, {\n          y: i % 2 === 0 ? -15 : 15,\n          x: i % 3 === 0 ? 5 : -5,\n          duration: 3 + i,\n          repeat: -1,\n          yoyo: true,\n          ease: \"sine.inOut\"\n        });\n      });\n\n      // 4. ScrollTrigger Fade-ups for Sections\n      gsap.utils.toArray('section').forEach(section => {\n        if(section.id === 'hero') return;\n        gsap.from(section.querySelectorAll('h2, p, .island-card, .timeline-step, #case-studies-carousel, #faq-stack-container, #contact-form-card'), {\n          autoAlpha: 0,\n          y: 40,\n          stagger: 0.1,\n          duration: 1,\n          ease: \"power3.out\",\n          scrollTrigger: {\n            trigger: section,\n            start: \"top 80%\",\n            toggleActions: \"play none none none\"\n          }\n        });\n      });\n\n      // 5. Timeline Draw\n      gsap.from(\"#timeline-svg-line\", {\n        strokeDashoffset: 1000,\n        scrollTrigger: {\n          trigger: \"#proceso\",\n          start: \"top 40%\",\n          end: \"bottom bottom\",\n          scrub: 2\n        }\n      });\n\n      // 6. FAQ Interaction\n      const faqCards = document.querySelectorAll('.faq-card');\n      const updateFAQ = (activeIndex) => {\n        faqCards.forEach((c, i) => {\n          const answer = c.querySelector('.faq-answer');\n          if (i === activeIndex) {\n            c.classList.add('faq-active');\n            gsap.to(c, { y: 0, scale: 1, opacity: 1, duration: 0.6, ease: \"power2.out\" });\n            gsap.to(answer, { height: 'auto', opacity: 1, marginTop: 24, duration: 0.4 });\n          } else {\n            c.classList.remove('faq-active');\n            const diff = i - activeIndex;\n            const offset = diff * 80;\n            const scale = 1 - (Math.abs(diff) * 0.05);\n            const opacity = diff > 0 ? 0.6 - (diff * 0.1) : 0; // Increased opacity for visibility\n            \n            gsap.to(c, { \n              y: offset, \n              scale: scale, \n              opacity: opacity, \n              zIndex: 40 - Math.abs(diff),\n              duration: 0.6,\n              ease: \"power2.out\"\n            });\n            gsap.to(answer, { height: 0, opacity: 0, marginTop: 0, duration: 0.4 });\n          }\n        });\n      };\n      \n      faqCards.forEach(card => {\n        card.addEventListener('click', () => updateFAQ(parseInt(card.dataset.index)));\n      });\n      // Initial state\n      updateFAQ(0);\n\n      // 7. Nav Hide/Reveal on Scroll\n      let lastScroll = 0;\n      window.addEventListener('scroll', () => {\n        const currentScroll = window.pageYOffset;\n        if (currentScroll > lastScroll && currentScroll > 150) {\n          gsap.to(\"#main-nav\", { y: -150, duration: 0.5, ease: \"power2.out\" });\n        } else {\n          gsap.to(\"#main-nav\", { y: 0, duration: 0.5, ease: \"power2.out\" });\n        }\n        lastScroll = currentScroll;\n      });\n\n      // 8. Carousel Navigation (Basic Scroll)\n      const carousel = document.querySelector('#case-studies-carousel');\n      document.querySelector('#next-btn').addEventListener('click', () => {\n        carousel.scrollBy({ left: 832, behavior: 'smooth' });\n      });\n      document.querySelector('#prev-btn').addEventListener('click', () => {\n        carousel.scrollBy({ left: -832, behavior: 'smooth' });\n      });\n    });\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-08-05T22:02:39.416832+00:00",
      "modified": "2026-08-05T22:02:39.416832+00:00",
      "id": "var_f3d8bf5e4ad3"
    },
    "var_17661e3132ba": {
      "type": "variant",
      "label": "NoRest — Friendly Bold Landing",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Epilogue:wght@400;700;900&family=Space+Grotesk:wght@400;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --purple: #290033;\n    --gold: #FFD800;\n    --lime: #00FF80;\n    --black: #1A1A1A;\n    --white: #FFFFFF;\n  }\n\n  body {\n    font-family: 'Space Grotesk', sans-serif;\n    color: var(--black);\n    background-color: var(--white);\n    overflow-x: clip; /* Prevent sticky breaking while hiding overflow */\n  }\n\n  h1, h2, h3, h4, .font-heading {\n    font-family: 'Epilogue', sans-serif;\n  }\n\n  .brutalist-border {\n    border: 3px solid var(--black);\n  }\n\n  .brutalist-shadow {\n    box-shadow: 6px 6px 0px var(--black);\n  }\n\n  .brutalist-shadow-hover:hover {\n    box-shadow: 0px 0px 0px var(--black);\n    transform: translate(6px, 6px);\n  }\n\n  .no-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .no-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n\n  .vertical-ticker {\n    writing-mode: vertical-rl;\n    text-orientation: mixed;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  /* GSAP targets should not have transitions */\n  .gsap-reveal, .gsap-card, .gsap-step, .gsap-line, .gsap-ticker, .gsap-marquee, .gsap-btn {\n    transition: none !important;\n  }\n\n  /* Custom Accordion Logic */\n  .faq-content {\n    height: 0;\n    overflow: hidden;\n  }\n  .faq-item.active .faq-header {\n    background-color: #fffde7;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    * {\n      animation-duration: 0.01ms !important;\n      animation-iteration-count: 1 !important;\n      transition-duration: 0.01ms !important;\n      scroll-behavior: auto !important;\n    }\n  }\n</style>\n<div class=\"w-full relative\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Nav -->\n    <nav class=\"sticky top-0 z-[100] bg-white brutalist-border border-t-0 border-x-0 px-8 py-5 flex justify-between items-center w-full\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n        <div class=\"flex items-center gap-2\" data-kid=\"1-1-1\" data-name=\"brand logo container\">\n            <img alt=\"NoRest Solutions Logo\" class=\"h-10 decoding-async\" data-kid=\"1-1-1-1\" data-name=\"company logo\" loading=\"lazy\" src=\"/api/local/images/public/assets/norest-logo.png\"/>\n        </div>\n        <div class=\"hidden lg:flex items-center gap-12 font-bold text-lg uppercase tracking-wider\" data-kid=\"1-1-2\" data-name=\"navigation link group\">\n            <a class=\"hover:text-[var(--purple)] border-b-3 border-transparent hover:border-[var(--purple)]\" data-kid=\"1-1-2-1\" data-name=\"navigation link servicios\" href=\"#servicios\">\n                Servicios\n            </a>\n            <a class=\"hover:text-[var(--purple)] border-b-3 border-transparent hover:border-[var(--purple)]\" data-kid=\"1-1-2-2\" data-name=\"navigation link proceso\" href=\"#proceso\">\n                Proceso\n            </a>\n            <a class=\"hover:text-[var(--purple)] border-b-3 border-transparent hover:border-[var(--purple)]\" data-kid=\"1-1-2-3\" data-name=\"navigation link proyectos\" href=\"#proyectos\">\n                Proyectos\n            </a>\n            <a class=\"hover:text-[var(--purple)] border-b-3 border-transparent hover:border-[var(--purple)]\" data-kid=\"1-1-2-4\" data-name=\"navigation link faq\" href=\"#faq\">\n                FAQ\n            </a>\n        </div>\n        <button class=\"bg-[var(--gold)] brutalist-border px-8 py-3 font-black text-lg brutalist-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-pointer\" data-kid=\"1-1-3\" data-name=\"call-to-action button\">\n            HABLEMOS\n        </button>\n    </nav>\n    <!-- Hero Section -->\n    <header class=\"min-h-[90vh] grid grid-cols-12 border-b-3 border-[var(--black)]\" data-kid=\"1-2\" data-name=\"hero section\">\n        <!-- Left Rail -->\n        <div class=\"col-span-1 bg-[var(--purple)] border-r-3 border-[var(--black)] flex flex-col items-center py-12 text-white relative overflow-hidden hidden md:flex\" data-kid=\"1-2-1\" data-name=\"hero sidebar ticker container\">\n            <div class=\"gsap-ticker-container flex flex-col gap-12 py-4 whitespace-nowrap text-2xl font-black uppercase tracking-[0.3em] vertical-ticker h-full\" data-kid=\"1-2-1-1\" data-name=\"hero sidebar ticker wrapper\">\n                <div class=\"gsap-ticker-track flex flex-col gap-24\" data-dynamic=\"true\" data-kid=\"1-2-1-1-1\" data-name=\"hero sidebar ticker track\" data-reason=\"ticker content duplicated and animated infinitely by GSAP\">\n                    <span data-dynamic=\"true\" data-kid=\"1-2-1-1-1-1\" data-name=\"ticker item 1\" data-reason=\"ticker content duplicated and animated infinitely by GSAP\">\n                        WEB • MÓVIL • DESKTOP • SISTEMAS\n                    </span>\n                    <span data-dynamic=\"true\" data-kid=\"1-2-1-1-1-2\" data-name=\"ticker item 2\" data-reason=\"ticker content duplicated and animated infinitely by GSAP\">\n                        WEB • MÓVIL • DESKTOP • SISTEMAS\n                    </span>\n                </div>\n            </div>\n        </div>\n        <!-- Center Content -->\n        <div class=\"col-span-12 md:col-span-7 flex flex-col justify-center px-8 lg:px-20 py-24 bg-white relative\" data-kid=\"1-2-2\" data-name=\"hero center content area\">\n            <div class=\"hero-stagger mb-8 flex flex-wrap items-center gap-4\" data-kid=\"1-2-2-1\" data-name=\"hero status and expertise container\">\n                <span class=\"bg-[var(--lime)] brutalist-border px-4 py-2 text-sm font-black uppercase tracking-widest brutalist-shadow\" data-kid=\"1-2-2-1-1\" data-name=\"hero status badge\">\n                    Status: Online\n                </span>\n                <span class=\"text-[var(--black)] font-bold opacity-70\" data-kid=\"1-2-2-1-2\" data-name=\"hero expertise text\">\n                    Expertos en desarrollo a medida desde 2024\n                </span>\n            </div>\n            <h1 class=\"hero-stagger text-7xl lg:text-9xl font-black leading-[0.85] uppercase mb-10 tracking-tighter\" data-kid=\"1-2-2-2\" data-name=\"hero main headline\">\n                SOFTWARE QUE\n                <br data-kid=\"1-2-2-2-1\" data-name=\"line break\"/>\n                <span class=\"inline-block relative\" data-kid=\"1-2-2-2-2\" data-name=\"highlighted text container\">\n                    <span class=\"relative z-10 px-4\" data-kid=\"1-2-2-2-2-1\" data-name=\"highlighted text\">\n                        NO SE\n                    </span>\n                    <div class=\"absolute inset-0 bg-[var(--gold)] brutalist-border -rotate-1 z-0\" data-kid=\"1-2-2-2-2-2\" data-name=\"highlighted text background rectangle\">\n                    </div>\n                </span>\n                <br data-kid=\"1-2-2-2-3\" data-name=\"line break\"/>\n                DETIENE\n            </h1>\n            <p class=\"hero-stagger text-2xl max-w-2xl mb-12 text-gray-700 font-medium leading-tight border-l-6 border-[var(--purple)] pl-8\" data-kid=\"1-2-2-3\" data-name=\"hero description text\">\n                Soluciones digitales robustas para hacer avanzar tu negocio. Web, móvil y sistemas complejos diseñados para escalar.\n            </p>\n            <div class=\"hero-stagger flex flex-wrap items-center gap-8\" data-kid=\"1-2-2-4\" data-name=\"hero call to action button group\">\n                <button class=\"bg-[var(--gold)] brutalist-border px-10 py-5 text-2xl font-black brutalist-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-pointer group\" data-kid=\"1-2-2-4-1\" data-name=\"hero call to action button\">\n                    CUÉNTANOS TU IDEA\n                    <i class=\"ti ti-arrow-right inline-block group-hover:translate-x-2 transition-transform ml-2\" data-kid=\"1-2-2-4-1-1\" data-name=\"arrow right icon\">\n                    </i>\n                </button>\n                <a class=\"text-xl font-bold border-b-4 border-[var(--purple)] hover:bg-[var(--purple)] hover:text-white px-2 transition-colors\" data-kid=\"1-2-2-4-2\" data-name=\"hero secondary action link\" href=\"#proyectos\">\n                    Explorar proyectos\n                </a>\n            </div>\n        </div>\n        <!-- Right Collage -->\n        <div class=\"col-span-12 md:col-span-4 bg-gray-50 border-l-3 border-[var(--black)] relative overflow-hidden flex items-center justify-center p-8\" data-kid=\"1-2-3\" data-name=\"hero visual collage container\">\n            <!-- Decorative Shapes -->\n            <div class=\"absolute top-10 right-10 w-32 h-32 bg-[var(--lime)] brutalist-border rounded-2xl rotate-12 gsap-shape-1\" data-kid=\"1-2-3-1\" data-name=\"decorative lime square\">\n            </div>\n            <div class=\"absolute bottom-10 left-10 w-48 h-48 bg-[var(--purple)]/10 brutalist-border rounded-full -rotate-12 gsap-shape-2\" data-kid=\"1-2-3-2\" data-name=\"decorative purple circle\">\n            </div>\n            <div class=\"absolute top-1/2 left-0 w-20 h-20 bg-[var(--gold)] brutalist-border rotate-45 gsap-shape-3\" data-kid=\"1-2-3-3\" data-name=\"decorative gold diamond\">\n            </div>\n            <div class=\"relative z-10 w-full max-w-md aspect-[4/5] brutalist-border brutalist-shadow bg-[var(--purple)] overflow-hidden\" data-kid=\"1-2-3-4\" data-name=\"hero image frame\">\n                <img alt=\"Abstract Purple and Yellow Tech Illustration by PixelPro Vibes on Unsplash\" class=\"w-full h-full object-cover grayscale-0\" data-kid=\"1-2-3-4-1\" data-name=\"hero tech illustration image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1776126508553-471f8c30cd61?auto=format&w=800&q=80&fit=crop\"/>\n            </div>\n        </div>\n    </header>\n    <!-- Services Section -->\n    <section class=\"py-32 px-8 lg:px-20 bg-white\" data-kid=\"1-3\" data-name=\"services section\" id=\"servicios\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-3-1\" data-name=\"services content wrapper\">\n            <div class=\"flex flex-col lg:flex-row lg:items-end justify-between mb-24 gap-8\" data-kid=\"1-3-1-1\" data-name=\"services header group\">\n                <div class=\"reveal-up\" data-kid=\"1-3-1-1-1\" data-name=\"services introduction text container\">\n                    <span class=\"text-[var(--purple)] font-black text-xl uppercase tracking-[0.2em] mb-4 block\" data-kid=\"1-3-1-1-1-1\" data-name=\"services eyebrow label\">\n                        Nuestras Capacidades\n                    </span>\n                    <h2 class=\"text-6xl lg:text-8xl font-black uppercase leading-[0.9] tracking-tighter\" data-kid=\"1-3-1-1-1-2\" data-name=\"services main headline\">\n                        SOLUCIONES\n                        <br data-kid=\"1-3-1-1-1-2-1\" data-name=\"line break\"/>\n                        <span class=\"text-gray-700\" data-kid=\"1-3-1-1-1-2-2\" data-name=\"services headline accent text\">\n                            QUE IMPACTAN\n                        </span>\n                    </h2>\n                </div>\n                <div class=\"reveal-up lg:max-w-md bg-[var(--purple)] text-white p-8 brutalist-border brutalist-shadow rotate-1\" data-kid=\"1-3-1-1-2\" data-name=\"services description box\">\n                    <p class=\"text-xl font-medium\" data-kid=\"1-3-1-1-2-1\" data-name=\"services description text\">\n                        No somos solo programadores. Somos arquitectos de soluciones que entienden tus metas de negocio.\n                    </p>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-1 md:grid-cols-12 gap-8 services-grid\" data-kid=\"1-3-1-2\" data-name=\"services card grid\">\n                <!-- Web -->\n                <div class=\"md:col-span-7 bg-white brutalist-border p-12 brutalist-shadow cursor-pointer group gsap-card\" data-kid=\"1-3-1-2-1\" data-name=\"web development service card\">\n                    <div class=\"flex justify-between items-start mb-12\" data-kid=\"1-3-1-2-1-1\" data-name=\"card top group\">\n                        <i class=\"ti ti-world text-8xl text-[var(--purple)]\" data-kid=\"1-3-1-2-1-1-1\" data-name=\"world icon\">\n                        </i>\n                        <span class=\"font-black text-6xl text-gray-100 group-hover:text-[var(--gold)] transition-colors\" data-kid=\"1-3-1-2-1-1-2\" data-name=\"card index number\">\n                            01\n                        </span>\n                    </div>\n                    <h3 class=\"text-4xl font-black mb-6 uppercase\" data-kid=\"1-3-1-2-1-2\" data-name=\"service card title\">\n                        Web Development\n                    </h3>\n                    <p class=\"text-2xl text-gray-700 leading-snug\" data-kid=\"1-3-1-2-1-3\" data-name=\"service card description\">\n                        Ecosistemas web complejos, PWAs y plataformas escalables que no conocen límites de tráfico.\n                    </p>\n                </div>\n                <!-- Mobile -->\n                <div class=\"md:col-span-5 bg-[var(--purple)] text-white brutalist-border p-12 brutalist-shadow cursor-pointer group gsap-card\" data-kid=\"1-3-1-2-2\" data-name=\"mobile apps service card\">\n                    <div class=\"flex justify-between items-start mb-12\" data-kid=\"1-3-1-2-2-1\" data-name=\"card top group\">\n                        <i class=\"ti ti-device-mobile text-8xl text-[var(--lime)]\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"mobile device icon\">\n                        </i>\n                        <span class=\"font-black text-6xl text-white/10 group-hover:text-[var(--lime)] transition-colors\" data-kid=\"1-3-1-2-2-1-2\" data-name=\"card index number\">\n                            02\n                        </span>\n                    </div>\n                    <h3 class=\"text-4xl font-black mb-6 uppercase text-[var(--lime)]\" data-kid=\"1-3-1-2-2-2\" data-name=\"service card title\">\n                        Apps Móviles\n                    </h3>\n                    <p class=\"text-2xl text-purple-100 leading-snug\" data-kid=\"1-3-1-2-2-3\" data-name=\"service card description\">\n                        iOS y Android nativos o multiplataforma. Experiencias fluidas que viven en el bolsillo de tus clientes.\n                    </p>\n                </div>\n                <!-- Desktop -->\n                <div class=\"md:col-span-5 bg-[var(--gold)] brutalist-border p-12 brutalist-shadow cursor-pointer group gsap-card\" data-kid=\"1-3-1-2-3\" data-name=\"desktop apps service card\">\n                    <div class=\"flex justify-between items-start mb-12\" data-kid=\"1-3-1-2-3-1\" data-name=\"card top group\">\n                        <i class=\"ti ti-device-desktop text-8xl text-[var(--black)]\" data-kid=\"1-3-1-2-3-1-1\" data-name=\"desktop device icon\">\n                        </i>\n                        <span class=\"font-black text-6xl text-black/5 group-hover:text-white transition-colors\" data-kid=\"1-3-1-2-3-1-2\" data-name=\"card index number\">\n                            03\n                        </span>\n                    </div>\n                    <h3 class=\"text-4xl font-black mb-6 uppercase\" data-kid=\"1-3-1-2-3-2\" data-name=\"service card title\">\n                        Desktop Apps\n                    </h3>\n                    <p class=\"text-2xl text-[var(--black)]/80 leading-snug\" data-kid=\"1-3-1-2-3-3\" data-name=\"service card description\">\n                        Software de alto rendimiento para Windows, macOS y Linux. Control total del hardware.\n                    </p>\n                </div>\n                <!-- Custom Systems -->\n                <div class=\"md:col-span-7 bg-[var(--lime)] brutalist-border p-12 brutalist-shadow cursor-pointer group gsap-card\" data-kid=\"1-3-1-2-4\" data-name=\"custom systems service card\">\n                    <div class=\"flex justify-between items-start mb-12\" data-kid=\"1-3-1-2-4-1\" data-name=\"card top group\">\n                        <i class=\"ti ti-cpu text-8xl text-[var(--purple)]\" data-kid=\"1-3-1-2-4-1-1\" data-name=\"cpu icon\">\n                        </i>\n                        <span class=\"font-black text-6xl text-black/5 group-hover:text-[var(--purple)] transition-colors\" data-kid=\"1-3-1-2-4-1-2\" data-name=\"card index number\">\n                            04\n                        </span>\n                    </div>\n                    <h3 class=\"text-4xl font-black mb-6 uppercase\" data-kid=\"1-3-1-2-4-2\" data-name=\"service card title\">\n                        Sistemas a Medida\n                    </h3>\n                    <p class=\"text-2xl text-[var(--black)]/80 leading-snug\" data-kid=\"1-3-1-2-4-3\" data-name=\"service card description\">\n                        ERPs, CRMs y microservicios diseñados específicamente para tus procesos internos.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Process Section -->\n    <section class=\"py-32 px-8 lg:px-20 bg-[var(--purple)] text-white relative overflow-hidden\" data-kid=\"1-4\" data-name=\"process section\" id=\"proceso\">\n        <!-- Winding S-Curve SVG Path -->\n        <div class=\"absolute inset-0 z-0 w-full h-full pointer-events-none opacity-40\" data-kid=\"1-4-1\" data-name=\"s-curve background container\">\n            <svg class=\"w-full h-full\" data-kid=\"1-4-1-1\" data-name=\"s-curve svg\" fill=\"none\" preserveaspectratio=\"none\" viewbox=\"0 0 1440 1800\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path class=\"gsap-line-path\" d=\"M720 0 C720 200, 200 300, 200 450 C200 600, 1240 700, 1240 900 C1240 1100, 200 1200, 200 1350 C200 1500, 720 1600, 720 1800\" stroke=\"var(--gold)\" stroke-dasharray=\"12 12\" stroke-width=\"6\">\n                </path>\n            </svg>\n        </div>\n        <div class=\"max-w-6xl mx-auto relative z-10\" data-kid=\"1-4-2\" data-name=\"process content wrapper\">\n            <div class=\"text-center mb-32\" data-kid=\"1-4-2-1\" data-name=\"process header group\">\n                <h2 class=\"text-6xl lg:text-8xl font-black uppercase mb-6 tracking-tighter\" data-kid=\"1-4-2-1-1\" data-name=\"process main headline\">\n                    Cómo\n                    <span class=\"text-[var(--gold)]\" data-kid=\"1-4-2-1-1-1\" data-name=\"process headline accent text\">\n                        lo hacemos\n                    </span>\n                </h2>\n                <p class=\"text-2xl text-purple-200 max-w-2xl mx-auto\" data-kid=\"1-4-2-1-2\" data-name=\"process description text\">\n                    Un proceso iterativo diseñado para la transparencia y la velocidad.\n                </p>\n            </div>\n            <div class=\"space-y-48\" data-kid=\"1-4-2-2\" data-name=\"process step list\">\n                <!-- Step 1 -->\n                <div class=\"flex flex-col md:flex-row items-center gap-12 gsap-step\" data-kid=\"1-4-2-2-1\" data-name=\"process step 1\">\n                    <div class=\"flex-1 text-right order-2 md:order-1\" data-kid=\"1-4-2-2-1-1\" data-name=\"step 1 content\">\n                        <h3 class=\"text-4xl font-black uppercase mb-4 text-[var(--gold)]\" data-kid=\"1-4-2-2-1-1-1\" data-name=\"step title\">\n                            1. Descubrimos\n                        </h3>\n                        <p class=\"text-xl text-purple-100\" data-kid=\"1-4-2-2-1-1-2\" data-name=\"step description\">\n                            Inmersión total en tu negocio. Definimos el alcance y los objetivos críticos para el éxito.\n                        </p>\n                        <div class=\"mt-4 flex justify-end gap-2\" data-kid=\"1-4-2-2-1-1-3\" data-name=\"step tag group\">\n                            <span class=\"bg-white/10 px-3 py-1 rounded text-xs font-bold border border-white/20\" data-kid=\"1-4-2-2-1-1-3-1\" data-name=\"step tag\">\n                                Trato Directo\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"w-24 h-24 bg-[var(--lime)] rounded-full border-4 border-[var(--black)] flex items-center justify-center text-4xl font-black text-[var(--black)] shadow-[0_0_30px_rgba(0,255,128,0.3)] order-1 md:order-2\" data-kid=\"1-4-2-2-1-2\" data-name=\"step 1 icon wrapper\">\n                        <i class=\"ti ti-search\" data-kid=\"1-4-2-2-1-2-1\" data-name=\"step 1 icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-1 hidden md:block order-3\" data-kid=\"1-4-2-2-1-3\" data-name=\"empty placeholder\">\n                    </div>\n                </div>\n                <!-- Step 2 -->\n                <div class=\"flex flex-col md:flex-row items-center gap-12 gsap-step\" data-kid=\"1-4-2-2-2\" data-name=\"process step 2\">\n                    <div class=\"flex-1 hidden md:block\" data-kid=\"1-4-2-2-2-1\" data-name=\"empty placeholder\">\n                    </div>\n                    <div class=\"w-24 h-24 bg-[var(--gold)] rounded-full border-4 border-[var(--black)] flex items-center justify-center text-4xl font-black text-[var(--black)] shadow-[0_0_30px_rgba(255,216,0,0.3)]\" data-kid=\"1-4-2-2-2-2\" data-name=\"step 2 icon wrapper\">\n                        <i class=\"ti ti-palette\" data-kid=\"1-4-2-2-2-2-1\" data-name=\"step 2 icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-1 text-left\" data-kid=\"1-4-2-2-2-3\" data-name=\"step 2 content\">\n                        <h3 class=\"text-4xl font-black uppercase mb-4 text-[var(--gold)]\" data-kid=\"1-4-2-2-2-3-1\" data-name=\"step title\">\n                            2. Diseñamos\n                        </h3>\n                        <p class=\"text-xl text-purple-100\" data-kid=\"1-4-2-2-2-3-2\" data-name=\"step description\">\n                            Prototipado rápido y diseño de experiencia. Validamos la usabilidad antes de escribir una sola línea de código.\n                        </p>\n                        <div class=\"mt-4 flex gap-2\" data-kid=\"1-4-2-2-2-3-3\" data-name=\"step tag group\">\n                            <span class=\"bg-white/10 px-3 py-1 rounded text-xs font-bold border border-white/20\" data-kid=\"1-4-2-2-2-3-3-1\" data-name=\"step tag\">\n                                Calidad Sostenible\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Step 3 -->\n                <div class=\"flex flex-col md:flex-row items-center gap-12 gsap-step\" data-kid=\"1-4-2-2-3\" data-name=\"process step 3\">\n                    <div class=\"flex-1 text-right order-2 md:order-1\" data-kid=\"1-4-2-2-3-1\" data-name=\"step 3 content\">\n                        <h3 class=\"text-4xl font-black uppercase mb-4 text-[var(--gold)]\" data-kid=\"1-4-2-2-3-1-1\" data-name=\"step title\">\n                            3. Construimos\n                        </h3>\n                        <p class=\"text-xl text-purple-100\" data-kid=\"1-4-2-2-3-1-2\" data-name=\"step description\">\n                            Desarrollo ágil en sprints de 2 semanas. Estarás viendo el progreso real de tu plataforma constantemente.\n                        </p>\n                        <div class=\"mt-4 flex justify-end gap-2\" data-kid=\"1-4-2-2-3-1-3\" data-name=\"step tag group\">\n                            <span class=\"bg-white/10 px-3 py-1 rounded text-xs font-bold border border-white/20\" data-kid=\"1-4-2-2-3-1-3-1\" data-name=\"step tag\">\n                                Entregas Claras\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"w-24 h-24 bg-[var(--lime)] rounded-full border-4 border-[var(--black)] flex items-center justify-center text-4xl font-black text-[var(--black)] shadow-[0_0_30px_rgba(0,255,128,0.3)] order-1 md:order-2\" data-kid=\"1-4-2-2-3-2\" data-name=\"step 3 icon wrapper\">\n                        <i class=\"ti ti-code\" data-kid=\"1-4-2-2-3-2-1\" data-name=\"step 3 icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-1 hidden md:block order-3\" data-kid=\"1-4-2-2-3-3\" data-name=\"empty placeholder\">\n                    </div>\n                </div>\n                <!-- Step 4 -->\n                <div class=\"flex flex-col md:flex-row items-center gap-12 gsap-step\" data-kid=\"1-4-2-2-4\" data-name=\"process step 4\">\n                    <div class=\"flex-1 hidden md:block\" data-kid=\"1-4-2-2-4-1\" data-name=\"empty placeholder\">\n                    </div>\n                    <div class=\"w-24 h-24 bg-[var(--gold)] rounded-full border-4 border-[var(--black)] flex items-center justify-center text-4xl font-black text-[var(--black)] shadow-[0_0_30px_rgba(255,216,0,0.3)]\" data-kid=\"1-4-2-2-4-2\" data-name=\"step 4 icon wrapper\">\n                        <i class=\"ti ti-rocket\" data-kid=\"1-4-2-2-4-2-1\" data-name=\"step 4 icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-1 text-left\" data-kid=\"1-4-2-2-4-3\" data-name=\"step 4 content\">\n                        <h3 class=\"text-4xl font-black uppercase mb-4 text-[var(--gold)]\" data-kid=\"1-4-2-2-4-3-1\" data-name=\"step title\">\n                            4. Lanzamos\n                        </h3>\n                        <p class=\"text-xl text-purple-100\" data-kid=\"1-4-2-2-4-3-2\" data-name=\"step description\">\n                            Despliegue controlado, soporte y optimización. Seguimos a tu lado para escalar la solución.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Projects Section -->\n    <section class=\"py-32 bg-gray-50 overflow-hidden\" data-kid=\"1-5\" data-name=\"projects section\" id=\"proyectos\">\n        <div class=\"px-8 lg:px-20 mb-20 flex flex-col md:flex-row md:items-end justify-between gap-8\" data-kid=\"1-5-1\" data-name=\"projects header group\">\n            <div data-kid=\"1-5-1-1\" data-name=\"projects main headline group\">\n                <h2 class=\"text-6xl lg:text-8xl font-black uppercase tracking-tighter leading-none mb-6\" data-kid=\"1-5-1-1-1\" data-name=\"projects main headline\">\n                    PROYECTOS\n                    <br data-kid=\"1-5-1-1-1-1\" data-name=\"line break\"/>\n                    <span class=\"text-gray-400\" data-kid=\"1-5-1-1-1-2\" data-name=\"projects headline accent text\">\n                        QUE HABLAN\n                    </span>\n                </h2>\n                <p class=\"text-2xl font-bold border-l-6 border-[var(--lime)] pl-8\" data-kid=\"1-5-1-1-2\" data-name=\"projects description text\">\n                    Casos de éxito que transformaron industrias.\n                </p>\n            </div>\n            <div class=\"flex gap-4\" data-kid=\"1-5-1-2\" data-name=\"projects navigation group\">\n                <button aria-label=\"Anterior\" class=\"w-16 h-16 brutalist-border rounded-full flex items-center justify-center hover:bg-[var(--gold)] transition-colors cursor-pointer\" data-kid=\"1-5-1-2-1\" data-name=\"previous project button\" id=\"project-prev\">\n                    <i class=\"ti ti-chevron-left text-2xl font-black\" data-kid=\"1-5-1-2-1-1\" data-name=\"chevron left icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Siguiente\" class=\"w-16 h-16 brutalist-border rounded-full flex items-center justify-center hover:bg-[var(--gold)] transition-colors cursor-pointer\" data-kid=\"1-5-1-2-2\" data-name=\"next project button\" id=\"project-next\">\n                    <i class=\"ti ti-chevron-right text-2xl font-black\" data-kid=\"1-5-1-2-2-1\" data-name=\"chevron right icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <div class=\"gsap-projects-rail flex gap-12 px-8 lg:px-20 pb-12 cursor-grab active:cursor-grabbing overflow-x-visible no-scrollbar\" data-dynamic=\"true\" data-kid=\"1-5-2\" data-name=\"projects carousel rail\" data-reason=\"rail horizontal position controlled by scroll position\">\n            <!-- Project 1 -->\n            <div class=\"min-w-[400px] md:min-w-[850px] bg-white brutalist-border brutalist-shadow flex flex-col md:flex-row\" data-kid=\"1-5-2-1\" data-name=\"project 1 card\">\n                <div class=\"w-full md:w-2/5 aspect-video md:aspect-auto border-b-3 md:border-b-0 md:border-r-3 border-[var(--black)] overflow-hidden\" data-kid=\"1-5-2-1-1\" data-name=\"project 1 image wrapper\">\n                    <img alt=\"Team working by Vitaly Gariev on Unsplash\" class=\"w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"1-5-2-1-1-1\" data-name=\"project 1 image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1758691737083-0e7fdbde0f05?auto=format&w=1000&q=80&fit=crop\"/>\n                </div>\n                <div class=\"p-10 flex-1 flex flex-col justify-between\" data-kid=\"1-5-2-1-2\" data-name=\"project 1 info wrapper\">\n                    <div data-kid=\"1-5-2-1-2-1\" data-name=\"project 1 details\">\n                        <div class=\"flex justify-between items-start mb-6\" data-kid=\"1-5-2-1-2-1-1\" data-name=\"project 1 title group\">\n                            <h3 class=\"text-4xl font-black uppercase\" data-kid=\"1-5-2-1-2-1-1-1\" data-name=\"project 1 title\">\n                                FINTECH NEXUS\n                            </h3>\n                            <span class=\"bg-[var(--lime)] px-4 py-1 brutalist-border text-sm font-black uppercase\" data-kid=\"1-5-2-1-2-1-1-2\" data-name=\"project 1 stat badge\">\n                                +80k Usuarios\n                            </span>\n                        </div>\n                        <p class=\"text-2xl italic text-gray-700 mb-10 leading-tight\" data-kid=\"1-5-2-1-2-1-2\" data-name=\"project 1 description\">\n                            \"Rediseñaron nuestro núcleo transaccional en tiempo récord. La escalabilidad ya no es una preocupación.\"\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-4 border-t-2 border-gray-100 pt-8\" data-kid=\"1-5-2-1-2-2\" data-name=\"project 1 client info\">\n                        <img alt=\"Carlos Mendoza\" class=\"w-16 h-16 rounded-full brutalist-border\" data-kid=\"1-5-2-1-2-2-1\" data-name=\"project 1 client avatar\" src=\"https://i.pravatar.cc/100?u=carlos\"/>\n                        <div data-kid=\"1-5-2-1-2-2-2\" data-name=\"project 1 client details\">\n                            <p class=\"font-black text-xl\" data-kid=\"1-5-2-1-2-2-2-1\" data-name=\"project 1 client name\">\n                                Carlos Mendoza\n                            </p>\n                            <p class=\"text-gray-500 font-medium\" data-kid=\"1-5-2-1-2-2-2-2\" data-name=\"project 1 client title\">\n                                CTO, Nexus Bank\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Project 2 -->\n            <div class=\"min-w-[400px] md:min-w-[850px] bg-white brutalist-border brutalist-shadow flex flex-col md:flex-row\" data-kid=\"1-5-2-2\" data-name=\"project 2 card\">\n                <div class=\"w-full md:w-2/5 aspect-video md:aspect-auto border-b-3 md:border-b-0 md:border-r-3 border-[var(--black)] overflow-hidden\" data-kid=\"1-5-2-2-1\" data-name=\"project 2 image wrapper\">\n                    <img alt=\"App on smartphone by Daniel Korpai on Unsplash\" class=\"w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"1-5-2-2-1-1\" data-name=\"project 2 image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551721434-8b94ddff0e6d?auto=format&w=1000&q=80&fit=crop\"/>\n                </div>\n                <div class=\"p-10 flex-1 flex flex-col justify-between\" data-kid=\"1-5-2-2-2\" data-name=\"project 2 info wrapper\">\n                    <div data-kid=\"1-5-2-2-2-1\" data-name=\"project 2 details\">\n                        <div class=\"flex justify-between items-start mb-6\" data-kid=\"1-5-2-2-2-1-1\" data-name=\"project 2 title group\">\n                            <h3 class=\"text-4xl font-black uppercase\" data-kid=\"1-5-2-2-2-1-1-1\" data-name=\"project 2 title\">\n                                ECOMMERCE CORE\n                            </h3>\n                            <span class=\"bg-[var(--gold)] px-4 py-1 brutalist-border text-sm font-black uppercase\" data-kid=\"1-5-2-2-2-1-1-2\" data-name=\"project 2 stat badge\">\n                                Load < 1s\n                            </span>\n                        </div>\n                        <p class=\"text-2xl italic text-gray-700 mb-10 leading-tight\" data-kid=\"1-5-2-2-2-1-2\" data-name=\"project 2 description\">\n                            \"La conversión aumentó un 45% tras implementar el nuevo motor de búsqueda y checkout.\"\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-4 border-t-2 border-gray-100 pt-8\" data-kid=\"1-5-2-2-2-2\" data-name=\"project 2 client info\">\n                        <img alt=\"Elena Ruiz\" class=\"w-16 h-16 rounded-full brutalist-border\" data-kid=\"1-5-2-2-2-2-1\" data-name=\"project 2 client avatar\" src=\"https://i.pravatar.cc/100?u=elena\"/>\n                        <div data-kid=\"1-5-2-2-2-2-2\" data-name=\"project 2 client details\">\n                            <p class=\"font-black text-xl\" data-kid=\"1-5-2-2-2-2-2-1\" data-name=\"project 2 client name\">\n                                Elena Ruiz\n                            </p>\n                            <p class=\"text-gray-500 font-medium\" data-kid=\"1-5-2-2-2-2-2-2\" data-name=\"project 2 client title\">\n                                Head of E-commerce, Modas Global\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- FAQ Section -->\n    <section class=\"py-32 px-8 lg:px-20 bg-white\" data-kid=\"1-6\" data-name=\"faq section\" id=\"faq\">\n        <div class=\"max-w-4xl mx-auto\" data-kid=\"1-6-1\" data-name=\"faq container\">\n            <div class=\"text-center mb-20\" data-kid=\"1-6-1-1\" data-name=\"faq header group\">\n                <h2 class=\"text-6xl lg:text-7xl font-black uppercase tracking-tighter mb-6\" data-kid=\"1-6-1-1-1\" data-name=\"faq main headline\">\n                    PREGUNTAS\n                    <br data-kid=\"1-6-1-1-1-1\" data-name=\"line break\"/>\n                    FRECUENTES\n                </h2>\n                <div class=\"w-24 h-3 bg-[var(--gold)] mx-auto\" data-kid=\"1-6-1-1-2\" data-name=\"faq decorative line\">\n                </div>\n            </div>\n            <div class=\"space-y-6 faq-container\" data-kid=\"1-6-1-2\" data-name=\"faq list\">\n                <!-- Item 1 -->\n                <div class=\"faq-item active brutalist-border\" data-kid=\"1-6-1-2-1\" data-name=\"faq item 1\">\n                    <button class=\"faq-header w-full flex justify-between items-center p-8 text-left cursor-pointer transition-colors hover:bg-gray-50\" data-kid=\"1-6-1-2-1-1\" data-name=\"faq item header button\">\n                        <span class=\"text-2xl font-black uppercase\" data-kid=\"1-6-1-2-1-1-1\" data-name=\"faq question text\">\n                            ¿Cuánto tiempo tarda un proyecto?\n                        </span>\n                        <i class=\"ti ti-plus text-3xl transition-transform transform rotate-45\" data-kid=\"1-6-1-2-1-1-2\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                    <div class=\"faq-content bg-white border-t-3 border-[var(--black)]\" data-dynamic=\"true\" data-kid=\"1-6-1-2-1-2\" data-name=\"faq answer content\" data-reason=\"height and padding controlled by JS accordion script\">\n                        <p class=\"text-xl text-gray-700 font-medium leading-relaxed\" data-kid=\"1-6-1-2-1-2-1\" data-name=\"faq answer text\">\n                            Depende de la complejidad. Un MVP (Producto Mínimo Viable) suele tomar entre 6 y 10 semanas. Proyectos de gran escala pueden extenderse de 4 a 6 meses con lanzamientos incrementales cada mes.\n                        </p>\n                    </div>\n                </div>\n                <!-- Item 2 -->\n                <div class=\"faq-item brutalist-border\" data-kid=\"1-6-1-2-2\" data-name=\"faq item 2\">\n                    <button class=\"faq-header w-full flex justify-between items-center p-8 text-left cursor-pointer transition-colors hover:bg-gray-50\" data-kid=\"1-6-1-2-2-1\" data-name=\"faq item header button\">\n                        <span class=\"text-2xl font-black uppercase\" data-kid=\"1-6-1-2-2-1-1\" data-name=\"faq question text\">\n                            ¿Ofrecen soporte post-lanzamiento?\n                        </span>\n                        <i class=\"ti ti-plus text-3xl transition-transform\" data-kid=\"1-6-1-2-2-1-2\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                    <div class=\"faq-content bg-white border-t-3 border-[var(--black)]\" data-dynamic=\"true\" data-kid=\"1-6-1-2-2-2\" data-name=\"faq answer content\" data-reason=\"height and padding controlled by JS accordion script\">\n                        <p class=\"text-xl text-gray-700 font-medium leading-relaxed\" data-kid=\"1-6-1-2-2-2-1\" data-name=\"faq answer text\">\n                            Absolutamente. No te dejamos solo. Ofrecemos planes de mantenimiento preventivo, soporte técnico 24/7 y actualizaciones de seguridad constantes para que tu software nunca se detenga.\n                        </p>\n                    </div>\n                </div>\n                <!-- Item 3 -->\n                <div class=\"faq-item brutalist-border\" data-kid=\"1-6-1-2-3\" data-name=\"faq item 3\">\n                    <button class=\"faq-header w-full flex justify-between items-center p-8 text-left cursor-pointer transition-colors hover:bg-gray-50\" data-kid=\"1-6-1-2-3-1\" data-name=\"faq item header button\">\n                        <span class=\"text-2xl font-black uppercase\" data-kid=\"1-6-1-2-3-1-1\" data-name=\"faq question text\">\n                            ¿Qué tecnologías utilizan?\n                        </span>\n                        <i class=\"ti ti-plus text-3xl transition-transform\" data-kid=\"1-6-1-2-3-1-2\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                    <div class=\"faq-content bg-white border-t-3 border-[var(--black)]\" data-dynamic=\"true\" data-kid=\"1-6-1-2-3-2\" data-name=\"faq answer content\" data-reason=\"height and padding controlled by JS accordion script\">\n                        <p class=\"text-xl text-gray-700 font-medium leading-relaxed\" data-kid=\"1-6-1-2-3-2-1\" data-name=\"faq answer text\">\n                            Somos agnósticos a la tecnología pero preferimos herramientas modernas y probadas: React/Next.js para web, Flutter o React Native para móvil, Rust o Go para sistemas de alto rendimiento y AWS/Google Cloud para infraestructura.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Contact Section -->\n    <section class=\"border-t-3 border-b-3 border-[var(--black)] flex flex-col md:flex-row min-h-[700px]\" data-kid=\"1-7\" data-name=\"contact section\" id=\"contacto\">\n        <!-- Left Context -->\n        <div class=\"flex-1 bg-[var(--purple)] p-12 lg:p-24 text-white flex flex-col justify-center\" data-kid=\"1-7-1\" data-name=\"contact sidebar content\">\n            <h2 class=\"text-6xl lg:text-8xl font-black uppercase leading-[0.9] tracking-tighter mb-10\" data-kid=\"1-7-1-1\" data-name=\"contact main headline\">\n                HAGAMOS\n                <br data-kid=\"1-7-1-1-1\" data-name=\"line break\"/>\n                ALGO QUE\n                <br data-kid=\"1-7-1-1-2\" data-name=\"line break\"/>\n                <span class=\"text-[var(--lime)]\" data-kid=\"1-7-1-1-3\" data-name=\"contact headline accent text\">\n                    SÍ AVANCE\n                </span>\n            </h2>\n            <p class=\"text-2xl text-purple-100 max-w-md mb-12\" data-kid=\"1-7-1-2\" data-name=\"contact description text\">\n                Estamos listos para escuchar tu idea y convertirla en una herramienta de negocio imparable.\n            </p>\n            <div class=\"space-y-6\" data-kid=\"1-7-1-3\" data-name=\"contact info group\">\n                <div class=\"flex items-center gap-6\" data-kid=\"1-7-1-3-1\" data-name=\"email container\">\n                    <div class=\"w-14 h-14 bg-[var(--lime)] rounded-full border-3 border-[var(--black)] flex items-center justify-center text-[var(--black)]\" data-kid=\"1-7-1-3-1-1\" data-name=\"email icon wrapper\">\n                        <i class=\"ti ti-mail text-2xl\" data-kid=\"1-7-1-3-1-1-1\" data-name=\"email icon\">\n                        </i>\n                    </div>\n                    <span class=\"text-2xl font-bold\" data-kid=\"1-7-1-3-1-2\" data-name=\"email address text\">\n                        hola@norest.tech\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-6\" data-kid=\"1-7-1-3-2\" data-name=\"phone container\">\n                    <div class=\"w-14 h-14 bg-[var(--gold)] rounded-full border-3 border-[var(--black)] flex items-center justify-center text-[var(--black)]\" data-kid=\"1-7-1-3-2-1\" data-name=\"phone icon wrapper\">\n                        <i class=\"ti ti-phone text-2xl\" data-kid=\"1-7-1-3-2-1-1\" data-name=\"phone icon\">\n                        </i>\n                    </div>\n                    <span class=\"text-2xl font-bold\" data-kid=\"1-7-1-3-2-2\" data-name=\"phone number text\">\n                        +34 900 123 456\n                    </span>\n                </div>\n            </div>\n        </div>\n        <!-- Right Form -->\n        <div class=\"flex-1 bg-white p-12 lg:p-24 flex flex-col justify-center relative\" data-kid=\"1-7-2\" data-name=\"contact form container\">\n            <form class=\"space-y-8\" data-kid=\"1-7-2-1\" data-name=\"contact form\" id=\"contact-form\">\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"1-7-2-1-1\" data-name=\"form row 1\">\n                    <div class=\"flex flex-col gap-3\" data-kid=\"1-7-2-1-1-1\" data-name=\"name field container\">\n                        <label class=\"font-black text-xl uppercase tracking-widest\" data-kid=\"1-7-2-1-1-1-1\" data-name=\"name field label\">\n                            Nombre\n                        </label>\n                        <input class=\"p-4 text-xl brutalist-border focus:bg-gray-50 focus:outline-hidden transition-colors border-2 focus:border-[var(--purple)]\" data-kid=\"1-7-2-1-1-1-2\" data-name=\"name field input\" placeholder=\"Tu nombre\" required=\"\" type=\"text\"/>\n                    </div>\n                    <div class=\"flex flex-col gap-3\" data-kid=\"1-7-2-1-1-2\" data-name=\"email field container\">\n                        <label class=\"font-black text-xl uppercase tracking-widest\" data-kid=\"1-7-2-1-1-2-1\" data-name=\"email field label\">\n                            Email\n                        </label>\n                        <input class=\"p-4 text-xl brutalist-border focus:bg-gray-50 focus:outline-hidden transition-colors border-2 focus:border-[var(--purple)]\" data-kid=\"1-7-2-1-1-2-2\" data-name=\"email field input\" placeholder=\"email@ejemplo.com\" required=\"\" type=\"email\"/>\n                    </div>\n                </div>\n                <div class=\"flex flex-col gap-3\" data-kid=\"1-7-2-1-2\" data-name=\"project type field container\">\n                    <label class=\"font-black text-xl uppercase tracking-widest\" data-kid=\"1-7-2-1-2-1\" data-name=\"project type label\">\n                        Tipo de Proyecto\n                    </label>\n                    <select class=\"p-4 text-xl brutalist-border bg-white focus:outline-hidden appearance-none cursor-pointer border-2 focus:border-[var(--purple)]\" data-kid=\"1-7-2-1-2-2\" data-name=\"project type select\">\n                        <option data-kid=\"1-7-2-1-2-2-1\" data-name=\"option 1\">\n                            Software Web\n                        </option>\n                        <option data-kid=\"1-7-2-1-2-2-2\" data-name=\"option 2\">\n                            App Móvil\n                        </option>\n                        <option data-kid=\"1-7-2-1-2-2-3\" data-name=\"option 3\">\n                            Sistemas a Medida\n                        </option>\n                        <option data-kid=\"1-7-2-1-2-2-4\" data-name=\"option 4\">\n                            Otros\n                        </option>\n                    </select>\n                </div>\n                <div class=\"flex flex-col gap-3\" data-kid=\"1-7-2-1-3\" data-name=\"message field container\">\n                    <label class=\"font-black text-xl uppercase tracking-widest\" data-kid=\"1-7-2-1-3-1\" data-name=\"message field label\">\n                        Mensaje\n                    </label>\n                    <textarea class=\"p-4 text-xl brutalist-border focus:bg-gray-50 focus:outline-hidden transition-colors border-2 focus:border-[var(--purple)] resize-none\" data-kid=\"1-7-2-1-3-2\" data-name=\"message field textarea\" placeholder=\"Cuéntanos brevemente qué tienes en mente...\" required=\"\" rows=\"4\"></textarea>\n                </div>\n                <button class=\"w-full bg-[var(--lime)] brutalist-border p-6 text-3xl font-black brutalist-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-pointer uppercase flex items-center justify-center gap-4\" data-kid=\"1-7-2-1-4\" data-name=\"submit button\" type=\"submit\">\n                    ENVIAR MENSAJE\n                    <i class=\"ti ti-send\" data-kid=\"1-7-2-1-4-1\" data-name=\"send icon\">\n                    </i>\n                </button>\n            </form>\n            <!-- Success State (Hidden by default) -->\n            <div class=\"absolute inset-0 bg-[var(--lime)] z-20 flex flex-col items-center justify-center p-12 text-center opacity-0 pointer-events-none transition-opacity duration-300\" data-dynamic=\"true\" data-kid=\"1-7-2-2\" data-name=\"success message container\" data-reason=\"opacity and pointer events controlled by JS form submission script\" id=\"success-message\">\n                <div class=\"w-32 h-32 bg-white rounded-full brutalist-border flex items-center justify-center text-6xl text-[var(--purple)] mb-8\" data-kid=\"1-7-2-2-1\" data-name=\"success icon wrapper\">\n                    <i class=\"ti ti-check\" data-kid=\"1-7-2-2-1-1\" data-name=\"success checkmark icon\">\n                    </i>\n                </div>\n                <h3 class=\"text-5xl font-black uppercase mb-4\" data-kid=\"1-7-2-2-2\" data-name=\"success headline\">\n                    ¡Recibido!\n                </h3>\n                <p class=\"text-2xl font-bold\" data-kid=\"1-7-2-2-3\" data-name=\"success description text\">\n                    Nos pondremos en contacto contigo en menos de 24 horas.\n                </p>\n                <button class=\"mt-8 font-black text-xl border-b-4 border-[var(--purple)] cursor-pointer\" data-kid=\"1-7-2-2-4\" data-name=\"success close button\" onclick=\"document.getElementById('success-message').classList.add('opacity-0', 'pointer-events-none')\">\n                    Cerrar\n                </button>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"bg-[var(--black)] text-white pt-32 pb-12 overflow-hidden\" data-kid=\"1-8\" data-name=\"footer\">\n        <div class=\"px-8 lg:px-20 max-w-7xl mx-auto\" data-kid=\"1-8-1\" data-name=\"footer main grid\">\n            <div class=\"flex flex-col lg:flex-row justify-between gap-20 mb-32\" data-kid=\"1-8-1-1\" data-name=\"footer top row\">\n                <!-- Brand -->\n                <div class=\"flex-1\" data-kid=\"1-8-1-1-1\" data-name=\"footer brand column\">\n                    <div class=\"bg-white p-4 inline-block brutalist-border mb-10\" data-kid=\"1-8-1-1-1-1\" data-name=\"footer logo wrapper\">\n                        <img alt=\"NoRest Solutions\" class=\"h-12 decoding-async\" data-kid=\"1-8-1-1-1-1-1\" data-name=\"footer logo\" loading=\"lazy\" src=\"/api/local/images/public/assets/norest-logo.png\"/>\n                    </div>\n                    <p class=\"text-3xl font-black uppercase leading-tight max-w-sm mb-12\" data-kid=\"1-8-1-1-1-2\" data-name=\"footer brand text\">\n                        Software diseñado para que tu negocio nunca se detenga.\n                    </p>\n                    <div class=\"flex gap-4\" data-kid=\"1-8-1-1-1-3\" data-name=\"social media links\">\n                        <a class=\"w-14 h-14 bg-white text-[var(--black)] rounded-full brutalist-border flex items-center justify-center hover:bg-[var(--gold)] transition-colors\" data-kid=\"1-8-1-1-1-3-1\" data-name=\"linkedin link\" href=\"#\">\n                            <i class=\"ti ti-brand-linkedin text-2xl\" data-kid=\"1-8-1-1-1-3-1-1\" data-name=\"linkedin icon\">\n                            </i>\n                        </a>\n                        <a class=\"w-14 h-14 bg-white text-[var(--black)] rounded-full brutalist-border flex items-center justify-center hover:bg-[var(--gold)] transition-colors\" data-kid=\"1-8-1-1-1-3-2\" data-name=\"twitter link\" href=\"#\">\n                            <i class=\"ti ti-brand-twitter text-2xl\" data-kid=\"1-8-1-1-1-3-2-1\" data-name=\"twitter icon\">\n                            </i>\n                        </a>\n                        <a class=\"w-14 h-14 bg-white text-[var(--black)] rounded-full brutalist-border flex items-center justify-center hover:bg-[var(--gold)] transition-colors\" data-kid=\"1-8-1-1-1-3-3\" data-name=\"github link\" href=\"#\">\n                            <i class=\"ti ti-brand-github text-2xl\" data-kid=\"1-8-1-1-1-3-3-1\" data-name=\"github icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <!-- Links -->\n                <div class=\"flex-1 grid grid-cols-2 md:grid-cols-3 gap-12\" data-kid=\"1-8-1-1-2\" data-name=\"footer link columns\">\n                    <div class=\"flex flex-col gap-6\" data-kid=\"1-8-1-1-2-1\" data-name=\"services links column\">\n                        <h4 class=\"text-[var(--gold)] font-black uppercase tracking-widest text-lg\" data-kid=\"1-8-1-1-2-1-1\" data-name=\"services header\">\n                            Servicios\n                        </h4>\n                        <a class=\"hover:text-[var(--lime)] transition-colors\" data-kid=\"1-8-1-1-2-1-2\" data-name=\"services link 1\" href=\"#\">\n                            Desarrollo Web\n                        </a>\n                        <a class=\"hover:text-[var(--lime)] transition-colors\" data-kid=\"1-8-1-1-2-1-3\" data-name=\"services link 2\" href=\"#\">\n                            Apps Móviles\n                        </a>\n                        <a class=\"hover:text-[var(--lime)] transition-colors\" data-kid=\"1-8-1-1-2-1-4\" data-name=\"services link 3\" href=\"#\">\n                            Sistemas Custom\n                        </a>\n                        <a class=\"hover:text-[var(--lime)] transition-colors\" data-kid=\"1-8-1-1-2-1-5\" data-name=\"services link 4\" href=\"#\">\n                            Consultoría\n                        </a>\n                    </div>\n                    <div class=\"flex flex-col gap-6\" data-kid=\"1-8-1-1-2-2\" data-name=\"company links column\">\n                        <h4 class=\"text-[var(--gold)] font-black uppercase tracking-widest text-lg\" data-kid=\"1-8-1-1-2-2-1\" data-name=\"company header\">\n                            Compañía\n                        </h4>\n                        <a class=\"hover:text-[var(--lime)] transition-colors\" data-kid=\"1-8-1-1-2-2-2\" data-name=\"company link 1\" href=\"#\">\n                            Proceso\n                        </a>\n                        <a class=\"hover:text-[var(--lime)] transition-colors\" data-kid=\"1-8-1-1-2-2-3\" data-name=\"company link 2\" href=\"#\">\n                            Proyectos\n                        </a>\n                        <a class=\"hover:text-[var(--lime)] transition-colors\" data-kid=\"1-8-1-1-2-2-4\" data-name=\"company link 3\" href=\"#\">\n                            Blog\n                        </a>\n                        <a class=\"hover:text-[var(--lime)] transition-colors\" data-kid=\"1-8-1-1-2-2-5\" data-name=\"company link 4\" href=\"#\">\n                            FAQ\n                        </a>\n                    </div>\n                    <div class=\"flex flex-col gap-6\" data-kid=\"1-8-1-1-2-3\" data-name=\"contact links column\">\n                        <h4 class=\"text-[var(--gold)] font-black uppercase tracking-widest text-lg\" data-kid=\"1-8-1-1-2-3-1\" data-name=\"contact header\">\n                            Contacto\n                        </h4>\n                        <a class=\"hover:text-[var(--lime)] transition-colors\" data-kid=\"1-8-1-1-2-3-2\" data-name=\"contact email\" href=\"#\">\n                            hola@norest.tech\n                        </a>\n                        <a class=\"hover:text-[var(--lime)] transition-colors\" data-kid=\"1-8-1-1-2-3-3\" data-name=\"contact phone\" href=\"#\">\n                            +34 900 123 456\n                        </a>\n                        <a class=\"hover:text-[var(--lime)] transition-colors\" data-kid=\"1-8-1-1-2-3-4\" data-name=\"contact address\" href=\"#\">\n                            Madrid, España\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"border-t-2 border-white/10 pt-12 flex flex-col md:flex-row justify-between items-center gap-8 text-gray-400 font-medium\" data-kid=\"1-8-1-2\" data-name=\"footer bottom row\">\n                <p data-kid=\"1-8-1-2-1\" data-name=\"copyright text\">\n                    © 2026 NoRest Solutions. Todos los derechos reservados.\n                </p>\n                <div class=\"flex gap-8\" data-kid=\"1-8-1-2-2\" data-name=\"footer legal links\">\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"1-8-1-2-2-1\" data-name=\"privacy policy link\" href=\"#\">\n                        Política de Privacidad\n                    </a>\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"1-8-1-2-2-2\" data-name=\"terms link\" href=\"#\">\n                        Términos y Condiciones\n                    </a>\n                </div>\n            </div>\n        </div>\n        <!-- Bottom Marquee -->\n        <div class=\"mt-24 border-t-3 border-white/20 py-12 relative overflow-hidden bg-[var(--purple)]\" data-kid=\"1-8-2\" data-name=\"footer marquee container\">\n            <div class=\"gsap-marquee whitespace-nowrap flex gap-12 items-center text-8xl md:text-[14rem] font-black text-white/25 uppercase select-none\" data-dynamic=\"true\" data-kid=\"1-8-2-1\" data-name=\"footer marquee wrapper\" data-reason=\"marquee content animated infinitely by GSAP\">\n                <span data-dynamic=\"true\" data-kid=\"1-8-2-1-1\" data-name=\"marquee text 1\" data-reason=\"marquee content animated infinitely by GSAP\">\n                    NO REST SOLUTIONS\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-8-2-1-2\" data-name=\"marquee dot 1\" data-reason=\"marquee content animated infinitely by GSAP\">\n                    •\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-8-2-1-3\" data-name=\"marquee text 2\" data-reason=\"marquee content animated infinitely by GSAP\">\n                    NO REST SOLUTIONS\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-8-2-1-4\" data-name=\"marquee dot 2\" data-reason=\"marquee content animated infinitely by GSAP\">\n                    •\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-8-2-1-5\" data-name=\"marquee text 3\" data-reason=\"marquee content animated infinitely by GSAP\">\n                    NO REST SOLUTIONS\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-8-2-1-6\" data-name=\"marquee dot 3\" data-reason=\"marquee content animated infinitely by GSAP\">\n                    •\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-8-2-1-7\" data-name=\"marquee text 4\" data-reason=\"marquee content animated infinitely by GSAP\">\n                    NO REST SOLUTIONS\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<!-- JS Libraries -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollToPlugin.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);\n</script>\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n    // 1. Hero Entrance Animations\n    const heroTl = gsap.timeline({ defaults: { ease: 'power4.out', duration: 1.2 } });\n    \n    heroTl.from('.hero-stagger', {\n      y: 100,\n      autoAlpha: 0,\n      stagger: 0.15,\n      delay: 0.2\n    })\n    .from('.gsap-ticker-container', {\n      xPercent: -100,\n      autoAlpha: 0,\n      duration: 1\n    }, '-=1')\n    .from(['.gsap-shape-1', '.gsap-shape-2', '.gsap-shape-3'], {\n      scale: 0,\n      rotation: 90,\n      autoAlpha: 0,\n      stagger: 0.2\n    }, '-=0.8');\n\n    // 2. Vertical Ticker Animation\n    const tickerTrack = document.querySelector('.gsap-ticker-track');\n    // Duplicate content for seamless loop\n    tickerTrack.innerHTML += tickerTrack.innerHTML;\n    gsap.to('.gsap-ticker-track', {\n      yPercent: -50,\n      duration: 20,\n      repeat: -1,\n      ease: 'none'\n    });\n\n    // 3. Reveal Up Animations\n    gsap.utils.toArray('.reveal-up').forEach(el => {\n      gsap.from(el, {\n        scrollTrigger: {\n          trigger: el,\n          start: 'top 85%'\n        },\n        y: 60,\n        autoAlpha: 0,\n        duration: 0.8,\n        ease: 'power3.out'\n      });\n    });\n\n    // 4. Batch Service Card Reveals\n    ScrollTrigger.batch('.gsap-card', {\n      onEnter: batch => {\n        gsap.from(batch, {\n          y: 80,\n          rotation: 3,\n          autoAlpha: 0,\n          stagger: 0.15,\n          duration: 1,\n          ease: 'back.out(1.4)'\n        });\n      },\n      start: 'top 85%'\n    });\n\n    // Hover effect for cards handled via JS to avoid CSS transition conflict\n    document.querySelectorAll('.gsap-card').forEach(card => {\n      card.addEventListener('mouseenter', () => {\n        gsap.to(card, { y: -10, duration: 0.3, ease: 'power2.out' });\n      });\n      card.addEventListener('mouseleave', () => {\n        gsap.to(card, { y: 0, duration: 0.3, ease: 'power2.out' });\n      });\n    });\n\n    // 5. Winding Timeline Path & Steps\n    const path = document.querySelector('.gsap-line-path');\n    const pathLength = path.getTotalLength();\n    \n    gsap.set(path, { strokeDasharray: pathLength, strokeDashoffset: pathLength });\n\n    gsap.to(path, {\n      strokeDashoffset: 0,\n      ease: 'none',\n      scrollTrigger: {\n        trigger: '#proceso',\n        start: 'top 30%',\n        end: 'bottom center',\n        scrub: 1\n      }\n    });\n\n    gsap.utils.toArray('.gsap-step').forEach(step => {\n      gsap.from(step, {\n        scrollTrigger: {\n          trigger: step,\n          start: 'top 80%'\n        },\n        x: step.querySelector('.text-right') ? -100 : 100,\n        autoAlpha: 0,\n        duration: 1,\n        ease: 'power4.out'\n      });\n    });\n\n    // 6. Project Rail Scroll\n    const rail = document.querySelector('.gsap-projects-rail');\n    const projectST = ScrollTrigger.create({\n      trigger: '#proyectos',\n      start: 'top 20%',\n      end: () => `+=${rail.scrollWidth}`,\n      scrub: 1,\n      pin: true,\n      animation: gsap.to(rail, {\n        x: () => -(rail.scrollWidth - window.innerWidth + 100),\n        ease: 'none'\n      }),\n      invalidateOnRefresh: true\n    });\n\n    // Project navigation buttons\n    document.getElementById('project-next').addEventListener('click', () => {\n      gsap.to(window, { scrollTo: window.scrollY + 800, duration: 0.8, ease: 'power2.inOut' });\n    });\n    document.getElementById('project-prev').addEventListener('click', () => {\n      gsap.to(window, { scrollTo: window.scrollY - 800, duration: 0.8, ease: 'power2.inOut' });\n    });\n\n    // 7. Footer Marquee\n    gsap.to('.gsap-marquee', {\n      xPercent: -50,\n      duration: 20,\n      repeat: -1,\n      ease: 'none'\n    });\n\n    // 8. FAQ Accordion Logic\n    const faqItems = document.querySelectorAll('.faq-item');\n    faqItems.forEach(item => {\n      const header = item.querySelector('.faq-header');\n      const content = item.querySelector('.faq-content');\n      const icon = item.querySelector('i');\n\n      if(item.classList.contains('active')) {\n        gsap.set(content, { height: 'auto', padding: '2rem' });\n      }\n\n      header.addEventListener('click', () => {\n        const isActive = item.classList.contains('active');\n        \n        // Close others\n        faqItems.forEach(i => {\n          if(i !== item && i.classList.contains('active')) {\n            i.classList.remove('active');\n            gsap.to(i.querySelector('.faq-content'), { height: 0, padding: 0, duration: 0.3 });\n            gsap.to(i.querySelector('i'), { rotation: 0, duration: 0.3 });\n          }\n        });\n\n        // Toggle current\n        if (!isActive) {\n          item.classList.add('active');\n          gsap.fromTo(content, { height: 0, padding: 0 }, { height: 'auto', padding: '2rem', duration: 0.3 });\n          gsap.to(icon, { rotation: 45, duration: 0.3 });\n        } else {\n          item.classList.remove('active');\n          gsap.to(content, { height: 0, padding: 0, duration: 0.3 });\n          gsap.to(icon, { rotation: 0, duration: 0.3 });\n        }\n      });\n    });\n\n    // 9. Contact Form Success State\n    const form = document.getElementById('contact-form');\n    const successMsg = document.getElementById('success-message');\n    form.addEventListener('submit', (e) => {\n      e.preventDefault();\n      // Simulate submission\n      gsap.to(successMsg, {\n        autoAlpha: 1,\n        pointerEvents: 'auto',\n        duration: 0.4\n      });\n      form.reset();\n    });\n  });\n</script>\n",
