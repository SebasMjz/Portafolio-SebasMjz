TEM_CORE\n                                            </option>\n                                            <option class=\"bg-[#1A1A24]\" data-kid=\"1-7-1-1-2-1-2-2-2-2-2-4\" data-name=\"option 4\">\n                                                DESKTOP_SOFT\n                                            </option>\n                                        </select>\n                                        <i class=\"ti ti-chevron-down absolute right-0 top-1/2 -translate-y-1/2 text-white/20 pointer-events-none\" data-kid=\"1-7-1-1-2-1-2-2-2-2-3\" data-name=\"dropdown icon\">\n                                        </i>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"space-y-2\" data-kid=\"1-7-1-1-2-1-2-3\" data-name=\"form field group 3\">\n                                <label class=\"block text-white/40 text-[10px] uppercase tracking-[0.3em] font-bold\" data-kid=\"1-7-1-1-2-1-2-3-1\" data-name=\"field label\">\n                                    04. REQUERIMIENTO_TÉCNICO:\n                                </label>\n                                <div class=\"flex items-start gap-4 group\" data-kid=\"1-7-1-1-2-1-2-3-2\" data-name=\"input wrapper\">\n                                    <span class=\"text-[#00FFFF] animate-pulse mt-3 group-focus-within:opacity-100\" data-kid=\"1-7-1-1-2-1-2-3-2-1\" data-name=\"input prompt\">\n                                        >>\n                                    </span>\n                                    <textarea class=\"w-full bg-transparent border-b border-white/10 py-3 focus:border-[#00FFFF] outline-none text-white transition-colors h-24 resize-none placeholder:text-white/10\" data-kid=\"1-7-1-1-2-1-2-3-2-2\" data-name=\"textarea\" placeholder=\"DESCRIBA_AQUÍ...\" required=\"\"></textarea>\n                                </div>\n                            </div>\n                            <div class=\"pt-8 flex flex-col md:flex-row items-center justify-between gap-8 border-t border-white/5\" data-kid=\"1-7-1-1-2-1-2-4\" data-name=\"form action row\">\n                                <div class=\"flex items-center gap-4\" data-kid=\"1-7-1-1-2-1-2-4-1\" data-name=\"transmission status container\">\n                                    <div class=\"flex gap-1.5\" data-kid=\"1-7-1-1-2-1-2-4-1-1\" data-name=\"loading animation group\">\n                                        <div class=\"w-1.5 h-1.5 bg-[#00FFFF] rounded-full animate-bounce\" data-kid=\"1-7-1-1-2-1-2-4-1-1-1\" data-name=\"dot 1\">\n                                        </div>\n                                        <div class=\"w-1.5 h-1.5 bg-[#00FFFF] rounded-full animate-bounce [animation-delay:0.2s]\" data-kid=\"1-7-1-1-2-1-2-4-1-1-2\" data-name=\"dot 2\">\n                                        </div>\n                                        <div class=\"w-1.5 h-1.5 bg-[#00FFFF] rounded-full animate-bounce [animation-delay:0.4s]\" data-kid=\"1-7-1-1-2-1-2-4-1-1-3\" data-name=\"dot 3\">\n                                        </div>\n                                    </div>\n                                    <span class=\"text-white/20 text-[10px] font-bold tracking-widest\" data-kid=\"1-7-1-1-2-1-2-4-1-2\" data-name=\"status label\">\n                                        READY_FOR_TRANSMISSION\n                                    </span>\n                                </div>\n                                <button class=\"w-full md:w-auto bg-[#00FFFF] text-[#010B13] px-12 py-5 font-black text-xs uppercase tracking-widest rounded hover:shadow-[0_0_40px_rgba(0,255,255,0.6)] transition-all duration-300\" data-kid=\"1-7-1-1-2-1-2-4-2\" data-name=\"submit button\" type=\"submit\">\n                                    EJECUTAR_COMANDO_ENVIAR\n                                </button>\n                            </div>\n                        </form>\n                        <!-- Success State (Hidden by default) -->\n                        <div class=\"hidden space-y-4 animate-fadeIn\" data-dynamic=\"true\" data-kid=\"1-7-1-1-2-1-3\" data-name=\"success message wrapper\" data-reason=\"visible/hidden state toggled by script\" id=\"success-msg\">\n                            <div class=\"flex items-center gap-3 text-[#00FF00]\" data-kid=\"1-7-1-1-2-1-3-1\" data-name=\"success icon and text\">\n                                <i class=\"ti ti-circle-check text-2xl\" data-kid=\"1-7-1-1-2-1-3-1-1\" data-name=\"success icon\">\n                                </i>\n                                <span class=\"font-bold text-lg\" data-kid=\"1-7-1-1-2-1-3-1-2\" data-name=\"success title\">\n                                    DATOS TRANSMITIDOS CON ÉXITO\n                                </span>\n                            </div>\n                            <p class=\"text-white/50\" data-kid=\"1-7-1-1-2-1-3-2\" data-name=\"success description\">\n                                Un arquitecto revisará tu requerimiento y responderá en menos de 24 horas hábiles.\n                            </p>\n                            <div class=\"pt-4\" data-kid=\"1-7-1-1-2-1-3-3\" data-name=\"success prompt container\">\n                                <span class=\"text-[#00FFFF]\" data-kid=\"1-7-1-1-2-1-3-3-1\" data-name=\"prompt symbol\">\n                                    $\n                                </span>\n                                <span class=\"text-white/20\" data-kid=\"1-7-1-1-2-1-3-3-2\" data-name=\"cursor indicator\">\n                                    _\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"bg-[#010B13] border-t border-white/5 pt-20 pb-10 px-6\" data-kid=\"1-8\" data-name=\"footer bar\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-8-1\" data-name=\"footer wrapper\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-20\" data-kid=\"1-8-1-1\" data-name=\"footer grid\">\n                <!-- Brand Column -->\n                <div class=\"space-y-6\" data-kid=\"1-8-1-1-1\" data-name=\"brand info column\">\n                    <div class=\"bg-white inline-block px-6 py-3 rounded-full mb-4 shadow-xl border border-white/5\" data-kid=\"1-8-1-1-1-1\" data-name=\"logo wrapper\">\n                        <img alt=\"NoRest Solutions\" class=\"h-8 w-auto object-contain\" data-kid=\"1-8-1-1-1-1-1\" data-name=\"footer logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/norest-logo.png\"/>\n                    </div>\n                    <p class=\"text-white/40 text-sm leading-relaxed pr-8\" data-kid=\"1-8-1-1-1-2\" data-name=\"description text\">\n                        Ingeniería de software para empresas que no pueden permitirse el fracaso. Precisión técnica, visión humana.\n                    </p>\n                    <div class=\"flex gap-4\" data-kid=\"1-8-1-1-1-3\" data-name=\"social links container\">\n                        <a class=\"w-10 h-10 rounded-full border border-white/10 flex items-center justify-center hover:border-[#00FFFF] hover:text-[#00FFFF] transition-all\" data-kid=\"1-8-1-1-1-3-1\" data-name=\"linkedin link\" href=\"#\">\n                            <i class=\"ti ti-brand-linkedin\" data-kid=\"1-8-1-1-1-3-1-1\" data-name=\"icon\">\n                            </i>\n                        </a>\n                        <a class=\"w-10 h-10 rounded-full border border-white/10 flex items-center justify-center hover:border-[#8A2BE2] hover:text-[#8A2BE2] transition-all\" data-kid=\"1-8-1-1-1-3-2\" data-name=\"github link\" href=\"#\">\n                            <i class=\"ti ti-brand-github\" data-kid=\"1-8-1-1-1-3-2-1\" data-name=\"icon\">\n                            </i>\n                        </a>\n                        <a class=\"w-10 h-10 rounded-full border border-white/10 flex items-center justify-center hover:border-[#00FFFF] hover:text-[#00FFFF] transition-all\" data-kid=\"1-8-1-1-1-3-3\" data-name=\"x link\" href=\"#\">\n                            <i class=\"ti ti-brand-x\" data-kid=\"1-8-1-1-1-3-3-1\" data-name=\"icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <!-- Sitemap -->\n                <div data-kid=\"1-8-1-1-2\" data-name=\"company sitemap\">\n                    <h4 class=\"font-jakarta font-bold mb-8 text-white\" data-kid=\"1-8-1-1-2-1\" data-name=\"column title\">\n                        Compañía\n                    </h4>\n                    <ul class=\"space-y-4 text-sm text-white/40\" data-kid=\"1-8-1-1-2-2\" data-name=\"links list\">\n                        <li data-kid=\"1-8-1-1-2-2-1\" data-name=\"link 1 wrapper\">\n                            <a class=\"hover:text-[#00FFFF] transition-colors\" data-kid=\"1-8-1-1-2-2-1-1\" data-name=\"link 1\" href=\"#\">\n                                Sobre Nosotros\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-2\" data-name=\"link 2 wrapper\">\n                            <a class=\"hover:text-[#00FFFF] transition-colors\" data-kid=\"1-8-1-1-2-2-2-1\" data-name=\"link 2\" href=\"#\">\n                                Metodología\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-3\" data-name=\"link 3 wrapper\">\n                            <a class=\"hover:text-[#00FFFF] transition-colors\" data-kid=\"1-8-1-1-2-2-3-1\" data-name=\"link 3\" href=\"#\">\n                                Carreras\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-4\" data-name=\"link 4 wrapper\">\n                            <a class=\"hover:text-[#00FFFF] transition-colors\" data-kid=\"1-8-1-1-2-2-4-1\" data-name=\"link 4\" href=\"#\">\n                                Blog Técnico\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-8-1-1-3\" data-name=\"services sitemap\">\n                    <h4 class=\"font-jakarta font-bold mb-8 text-white\" data-kid=\"1-8-1-1-3-1\" data-name=\"column title\">\n                        Servicios\n                    </h4>\n                    <ul class=\"space-y-4 text-sm text-white/40\" data-kid=\"1-8-1-1-3-2\" data-name=\"links list\">\n                        <li data-kid=\"1-8-1-1-3-2-1\" data-name=\"link 1 wrapper\">\n                            <a class=\"hover:text-[#8A2BE2] transition-colors\" data-kid=\"1-8-1-1-3-2-1-1\" data-name=\"link 1\" href=\"#\">\n                                Desarrollo Web\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-3-2-2\" data-name=\"link 2 wrapper\">\n                            <a class=\"hover:text-[#8A2BE2] transition-colors\" data-kid=\"1-8-1-1-3-2-2-1\" data-name=\"link 2\" href=\"#\">\n                                Mobile Apps\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-3-2-3\" data-name=\"link 3 wrapper\">\n                            <a class=\"hover:text-[#8A2BE2] transition-colors\" data-kid=\"1-8-1-1-3-2-3-1\" data-name=\"link 3\" href=\"#\">\n                                Backend & Systems\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-3-2-4\" data-name=\"link 4 wrapper\">\n                            <a class=\"hover:text-[#8A2BE2] transition-colors\" data-kid=\"1-8-1-1-3-2-4-1\" data-name=\"link 4\" href=\"#\">\n                                Cloud Consulting\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <!-- Contact -->\n                <div data-kid=\"1-8-1-1-4\" data-name=\"footer contact info\">\n                    <h4 class=\"font-jakarta font-bold mb-8 text-white\" data-kid=\"1-8-1-1-4-1\" data-name=\"column title\">\n                        Contacto\n                    </h4>\n                    <ul class=\"space-y-6 text-sm text-white/40\" data-kid=\"1-8-1-1-4-2\" data-name=\"contact list\">\n                        <li class=\"flex items-start gap-4\" data-kid=\"1-8-1-1-4-2-1\" data-name=\"contact item 1\">\n                            <i class=\"ti ti-mail text-lg text-[#00FFFF]\" data-kid=\"1-8-1-1-4-2-1-1\" data-name=\"email icon\">\n                            </i>\n                            <span data-kid=\"1-8-1-1-4-2-1-2\" data-name=\"email text\">\n                                contacto@norest.solutions\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-4\" data-kid=\"1-8-1-1-4-2-2\" data-name=\"contact item 2\">\n                            <i class=\"ti ti-map-pin text-lg text-[#00FFFF]\" data-kid=\"1-8-1-1-4-2-2-1\" data-name=\"location icon\">\n                            </i>\n                            <span data-kid=\"1-8-1-1-4-2-2-2\" data-name=\"location address text\">\n                                Tech District, Polanco\n                                <br data-kid=\"1-8-1-1-4-2-2-2-1\" data-name=\"line break\"/>\n                                Ciudad de México\n                            </span>\n                        </li>\n                        <li class=\"pt-2\" data-kid=\"1-8-1-1-4-2-3\" data-name=\"system status item\">\n                            <div class=\"bg-[#1A1A24] border border-white/10 p-4 rounded-xl flex items-center gap-3\" data-kid=\"1-8-1-1-4-2-3-1\" data-name=\"status container\">\n                                <div class=\"w-2 h-2 rounded-full bg-[#00FF00]\" data-kid=\"1-8-1-1-4-2-3-1-1\" data-name=\"status indicator dot\">\n                                </div>\n                                <span class=\"text-[10px] font-bold tracking-widest uppercase\" data-kid=\"1-8-1-1-4-2-3-1-2\" data-name=\"status label\">\n                                    System Status: Operational\n                                </span>\n                            </div>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"pt-10 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6\" data-kid=\"1-8-1-2\" data-name=\"footer bottom row\">\n                <p class=\"text-white/20 text-xs\" data-kid=\"1-8-1-2-1\" data-name=\"copyright text\">\n                    © 2026 NoRest Solutions S.A. de C.V. Todos los derechos reservados.\n                </p>\n                <div class=\"flex gap-8 text-[10px] uppercase tracking-widest font-bold text-white/20\" data-kid=\"1-8-1-2-2\" data-name=\"legal links container\">\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"1-8-1-2-2-1\" data-name=\"legal link 1\" href=\"#\">\n                        Legal\n                    </a>\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"1-8-1-2-2-2\" data-name=\"legal link 2\" href=\"#\">\n                        Privacidad\n                    </a>\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"1-8-1-2-2-3\" data-name=\"legal link 3\" href=\"#\">\n                        Cookies\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n    <!-- GSAP & ScrollTrigger -->\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n    </script>\n    <script>\n        gsap.registerPlugin(ScrollTrigger);\n\n        document.addEventListener('DOMContentLoaded', () => {\n            // Bento Grid Entrance\n            gsap.from('.bento-cell', {\n                duration: 1.2,\n                opacity: 0,\n                y: 50,\n                stagger: 0.15,\n                ease: \"power4.out\",\n                clearProps: \"all\"\n            });\n\n            // Parallax Hex Shapes\n            document.querySelectorAll('.parallax-hex').forEach(hex => {\n                gsap.to(hex, {\n                    yPercent: -100 * parseFloat(hex.dataset.speed),\n                    scrollTrigger: {\n                        trigger: hex,\n                        scrub: true\n                    }\n                });\n            });\n\n            // Metric Count-up\n            document.querySelectorAll('.metric-count').forEach(counter => {\n                const target = parseInt(counter.dataset.val);\n                gsap.to(counter, {\n                    innerText: target,\n                    duration: 2,\n                    snap: { innerText: 1 },\n                    scrollTrigger: {\n                        trigger: counter,\n                        start: \"top 90%\",\n                        once: true\n                    }\n                });\n            });\n\n            // Services Slide-in\n            gsap.from('.service-card', {\n                scrollTrigger: {\n                    trigger: '#servicios',\n                    start: \"top 80%\"\n                },\n                x: -50,\n                opacity: 0,\n                stagger: 0.2,\n                duration: 1,\n                ease: \"power3.out\"\n            });\n\n            // Process Line Draw\n            gsap.to('#process-line-draw', {\n                width: \"100%\",\n                scrollTrigger: {\n                    trigger: '#proceso',\n                    start: \"top center\",\n                    end: \"bottom center\",\n                    scrub: 1\n                }\n            });\n\n            // Case Result Entrance\n            gsap.from('.case-result-row', {\n                scrollTrigger: {\n                    trigger: '#proyectos',\n                    start: \"top 70%\"\n                },\n                x: -100,\n                opacity: 0,\n                stagger: 0.3,\n                duration: 1.2,\n                ease: \"expo.out\"\n            });\n\n            // FAQ Interactivity\n            document.querySelectorAll('.faq-item').forEach(item => {\n                const answer = item.querySelector('.faq-answer');\n                const icon = item.querySelector('i');\n                \n                item.addEventListener('click', () => {\n                    const isOpen = !answer.classList.contains('hidden');\n                    \n                    // Close all others\n                    document.querySelectorAll('.faq-answer').forEach(ans => ans.classList.add('hidden'));\n                    document.querySelectorAll('.faq-item i').forEach(ic => ic.classList.remove('rotate-45'));\n\n                    if (!isOpen) {\n                        answer.classList.remove('hidden');\n                        icon.classList.add('rotate-45');\n                        // Using gsap.fromTo for safe height animation\n                        gsap.fromTo(answer, \n                            { height: 0, opacity: 0 },\n                            { height: \"auto\", opacity: 1, duration: 0.4, ease: \"power2.out\" }\n                        );\n                    }\n                });\n            });\n\n            // Contact Form Submission Mock\n            const contactForm = document.getElementById('contact-form');\n            const successMsg = document.getElementById('success-msg');\n\n            contactForm.addEventListener('submit', (e) => {\n                e.preventDefault();\n                gsap.to(contactForm, {\n                    opacity: 0,\n                    y: -20,\n                    duration: 0.5,\n                    onComplete: () => {\n                        contactForm.classList.add('hidden');\n                        successMsg.classList.remove('hidden');\n                        gsap.from(successMsg, {\n                            opacity: 0,\n                            y: 20,\n                            duration: 0.5\n                        });\n                    }\n                });\n            });\n\n            // Terminal Typewriter Effect (Robust GSAP approach)\n            const typewriter = document.querySelector('.typewriter-text');\n            const originalText = \"sh inicializar_consulta.sh --nuevo-proyecto --urgente\";\n            \n            ScrollTrigger.create({\n                trigger: '#contacto',\n                start: \"top 80%\",\n                onEnter: () => {\n                    let textObj = { val: 0 };\n                    gsap.to(textObj, {\n                        duration: 2.0,\n                        val: originalText.length,\n                        ease: \"none\",\n                        onUpdate: () => {\n                            const currentLen = Math.floor(textObj.val);\n                            typewriter.innerText = originalText.substring(0, currentLen) + \"_\";\n                        },\n                        onComplete: () => {\n                            typewriter.innerText = originalText;\n                            // Blink cursor using a separate element or just toggling visibility would be safer\n                            // Let's just use a simple interval-like GSAP toggle\n                            gsap.to(typewriter, {\n                                opacity: 0.7,\n                                duration: 0.5,\n                                repeat: -1,\n                                yoyo: true,\n                                ease: \"steps(1)\"\n                            });\n                        }\n                    });\n                },\n                once: true\n            });\n        });\n    </script>\n</div>\n",
