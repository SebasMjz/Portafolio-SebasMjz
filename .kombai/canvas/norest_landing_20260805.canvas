    },
    "var_d15ff367b540": {
      "type": "variant",
      "label": "NoRest — Deep Space Landing",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<div class=\"bg-[#010B13] text-white font-['IBM_Plex_Sans'] selection:bg-[#00FFFF] selection:text-[#010B13] overflow-x-clip\" data-kid=\"1\" data-name=\"page root container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        :root {\n            --ink-black: #010B13;\n            --dark-card: #1A1A24;\n            --violet: #8A2BE2;\n            --cyan: #00FFFF;\n        }\n\n        .font-jakarta { font-family: 'Plus_Jakarta_Sans', sans-serif; }\n        .font-mono { font-family: 'IBM_Plex_Mono', monospace; }\n\n        .glass-card {\n            background: var(--dark-card);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n        }\n\n        .neon-glow-cyan:hover {\n            box-shadow: 0 0 25px rgba(0, 255, 255, 0.15);\n            border-color: rgba(0, 255, 255, 0.3);\n        }\n\n        .neon-glow-violet:hover {\n            box-shadow: 0 0 25px rgba(138, 43, 226, 0.15);\n            border-color: rgba(138, 43, 226, 0.3);\n        }\n\n        /* Hide scrollbar for Chrome, Safari and Opera */\n        .no-scrollbar::-webkit-scrollbar {\n            display: none;\n        }\n\n        /* Hide scrollbar for IE, Edge and Firefox */\n        .no-scrollbar {\n            -ms-overflow-style: none;  /* IE and Edge */\n            scrollbar-width: none;  /* Firefox */\n        }\n    </style>\n    <!-- Navigation -->\n    <nav class=\"fixed top-0 left-0 w-full z-50 px-6 py-4\" data-kid=\"1-1\" data-name=\"main navigation header\">\n        <div class=\"max-w-7xl mx-auto flex items-center justify-between glass-card rounded-full px-8 py-3 backdrop-blur-md\" data-kid=\"1-1-1\" data-name=\"navigation wrapper container\">\n            <div class=\"flex items-center gap-10\" data-kid=\"1-1-1-1\" data-name=\"navigation left section\">\n                <!-- Logo Capsule -->\n                <div class=\"bg-white px-4 py-2 rounded-full flex items-center justify-center shadow-lg hover:scale-105 transition-transform duration-300 cursor-pointer\" data-kid=\"1-1-1-1-1\" data-name=\"logo container\">\n                    <img alt=\"NoRest Solutions\" class=\"h-7 w-auto object-contain\" data-kid=\"1-1-1-1-1-1\" data-name=\"company logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/norest-logo.png\"/>\n                </div>\n                <div class=\"hidden md:flex items-center gap-8 text-xs uppercase tracking-widest font-bold text-white/50\" data-kid=\"1-1-1-1-2\" data-name=\"navigation menu links container\">\n                    <a class=\"hover:text-[#00FFFF] transition-colors\" data-kid=\"1-1-1-1-2-1\" data-name=\"navigation link servicios\" href=\"#servicios\">\n                        Servicios\n                    </a>\n                    <a class=\"hover:text-[#00FFFF] transition-colors\" data-kid=\"1-1-1-1-2-2\" data-name=\"navigation link proceso\" href=\"#proceso\">\n                        Proceso\n                    </a>\n                    <a class=\"hover:text-[#00FFFF] transition-colors\" data-kid=\"1-1-1-1-2-3\" data-name=\"navigation link proyectos\" href=\"#proyectos\">\n                        Proyectos\n                    </a>\n                    <a class=\"hover:text-[#00FFFF] transition-colors\" data-kid=\"1-1-1-1-2-4\" data-name=\"navigation link faq\" href=\"#faq\">\n                        FAQ\n                    </a>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-1-1-2\" data-name=\"navigation right section\">\n                <div class=\"hidden lg:flex items-center gap-2.5 bg-[#00FF00]/10 border border-[#00FF00]/20 px-4 py-1.5 rounded-full text-[10px] uppercase tracking-[0.15em] font-bold text-[#00FF00]\" data-kid=\"1-1-1-2-1\" data-name=\"status indicator container\">\n                    <span class=\"w-1.5 h-1.5 bg-[#00FF00] rounded-full animate-ping\" data-kid=\"1-1-1-2-1-1\" data-name=\"status ping indicator\">\n                    </span>\n                    Status: Disponible\n                </div>\n                <button class=\"bg-[#00FFFF] text-[#010B13] px-6 py-2.5 rounded-full text-xs font-black uppercase tracking-wider hover:shadow-[0_0_20px_rgba(0,255,255,0.5)] transition-shadow cursor-pointer\" data-kid=\"1-1-1-2-2\" data-name=\"start consultation button\">\n                    Iniciar consulta\n                </button>\n            </div>\n        </div>\n    </nav>\n    <!-- Hero Section -->\n    <section class=\"relative pt-32 pb-20 px-6 overflow-hidden\" data-kid=\"1-2\" data-name=\"hero section\">\n        <!-- Abstract hex background elements -->\n        <div class=\"absolute top-1/4 left-10 opacity-10 parallax-hex\" data-kid=\"1-2-1\" data-name=\"parallax hexagon decorative element\" data-speed=\"0.05\">\n            <i class=\"ti ti-hexagons text-[180px] text-[#8A2BE2]\" data-kid=\"1-2-1-1\" data-name=\"hexagon icon\">\n            </i>\n        </div>\n        <div class=\"absolute bottom-1/4 right-10 opacity-10 parallax-hex\" data-kid=\"1-2-2\" data-name=\"parallax 3d hexagon decorative element\" data-speed=\"-0.03\">\n            <i class=\"ti ti-hexagon-3d text-[220px] text-[#00FFFF]\" data-kid=\"1-2-2-1\" data-name=\"3d hexagon icon\">\n            </i>\n        </div>\n        <div class=\"max-w-7xl mx-auto grid grid-cols-12 gap-4 auto-rows-[160px]\" data-kid=\"1-2-3\" data-name=\"hero bento grid container\">\n            <!-- Main Content Bento Cell -->\n            <div class=\"bento-cell col-span-12 lg:col-span-8 row-span-3 glass-card rounded-3xl p-8 md:p-14 flex flex-col justify-center relative overflow-hidden\" data-kid=\"1-2-3-1\" data-name=\"main content bento cell\">\n                <div class=\"absolute -top-32 -right-32 w-80 h-80 bg-[#8A2BE2]/5 blur-[120px] rounded-full\" data-kid=\"1-2-3-1-1\" data-name=\"hero background blur\">\n                </div>\n                <h1 class=\"font-jakarta text-5xl md:text-7xl font-extrabold leading-[1.1] mb-8\" data-kid=\"1-2-3-1-2\" data-name=\"hero headline\">\n                    Sistemas que hacen\n                    <br data-kid=\"1-2-3-1-2-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-[#00FFFF]\" data-kid=\"1-2-3-1-2-2\" data-name=\"headline highlight text\">\n                        avanzar\n                    </span>\n                    el trabajo\n                </h1>\n                <p class=\"text-white/60 text-lg md:text-xl max-w-2xl mb-12 leading-relaxed\" data-kid=\"1-2-3-1-3\" data-name=\"hero subheadline description\">\n                    Especialistas en ingeniería de software de alta precisión. Construimos aplicaciones web, móviles y de escritorio que transforman operaciones críticas en ventajas competitivas.\n                </p>\n                <div class=\"flex flex-wrap gap-4\" data-kid=\"1-2-3-1-4\" data-name=\"hero call to action button group\">\n                    <button class=\"bg-[#00FFFF] text-[#010B13] px-8 py-4 rounded-full font-bold hover:shadow-[0_0_25px_rgba(0,255,255,0.4)] transition-shadow flex items-center gap-2\" data-kid=\"1-2-3-1-4-1\" data-name=\"primary view portfolio button\">\n                        Ver Portafolio\n                        <i class=\"ti ti-arrow-right\" data-kid=\"1-2-3-1-4-1-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </button>\n                    <button class=\"border border-white/10 hover:bg-white/5 px-8 py-4 rounded-full font-bold transition-all\" data-kid=\"1-2-3-1-4-2\" data-name=\"secondary methodology button\">\n                        Nuestra Metodología\n                    </button>\n                </div>\n            </div>\n            <!-- Metric Cell 1 -->\n            <div class=\"bento-cell col-span-12 md:col-span-6 lg:col-span-4 row-span-1 glass-card rounded-3xl p-8 flex flex-col justify-between group overflow-hidden\" data-kid=\"1-2-3-2\" data-name=\"metric cell 1 container\">\n                <div class=\"text-[#8A2BE2] bg-[#8A2BE2]/10 w-12 h-12 rounded-xl flex items-center justify-center mb-4\" data-kid=\"1-2-3-2-1\" data-name=\"metric icon container\">\n                    <i class=\"ti ti-target-arrow text-2xl\" data-kid=\"1-2-3-2-1-1\" data-name=\"target arrow icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-3-2-2\" data-name=\"metric text container\">\n                    <div class=\"text-4xl font-jakarta font-bold mb-1\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-1\" data-name=\"metric percentage value\" data-reason=\"text updated from 0 to target value on load by script\">\n                        <span class=\"metric-count\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"metric counter value\" data-reason=\"text updated from 0 to target value on load by script\" data-val=\"98\">\n                            0\n                        </span>\n                        %\n                    </div>\n                    <div class=\"text-white/40 text-xs uppercase tracking-widest font-semibold\" data-kid=\"1-2-3-2-2-2\" data-name=\"metric percentage label\">\n                        Claridad de alcance inicial\n                    </div>\n                </div>\n            </div>\n            <!-- Metric Cell 2 -->\n            <div class=\"bento-cell col-span-6 md:col-span-3 lg:col-span-2 row-span-1 glass-card rounded-3xl p-8 flex flex-col justify-between group overflow-hidden\" data-kid=\"1-2-3-3\" data-name=\"metric cell 2 container\">\n                <div class=\"text-[#00FFFF] bg-[#00FFFF]/10 w-12 h-12 rounded-xl flex items-center justify-center mb-4\" data-kid=\"1-2-3-3-1\" data-name=\"metric icon container\">\n                    <i class=\"ti ti-stack-2 text-2xl\" data-kid=\"1-2-3-3-1-1\" data-name=\"stack icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-3-3-2\" data-name=\"metric text container\">\n                    <div class=\"text-4xl font-jakarta font-bold mb-1\" data-dynamic=\"true\" data-kid=\"1-2-3-3-2-1\" data-name=\"metric integer value\" data-reason=\"text updated from 0 to target value on load by script\">\n                        <span class=\"metric-count\" data-dynamic=\"true\" data-kid=\"1-2-3-3-2-1-1\" data-name=\"metric counter value\" data-reason=\"text updated from 0 to target value on load by script\" data-val=\"4\">\n                            0\n                        </span>\n                    </div>\n                    <div class=\"text-white/40 text-xs uppercase tracking-widest font-semibold\" data-kid=\"1-2-3-3-2-2\" data-name=\"metric label\">\n                        Tipos de producto\n                    </div>\n                </div>\n            </div>\n            <!-- Metric Cell 3 -->\n            <div class=\"bento-cell col-span-6 md:col-span-3 lg:col-span-2 row-span-1 glass-card rounded-3xl p-8 flex flex-col justify-between group overflow-hidden\" data-kid=\"1-2-3-4\" data-name=\"metric cell 3 container\">\n                <div class=\"text-[#8A2BE2] bg-[#8A2BE2]/10 w-12 h-12 rounded-xl flex items-center justify-center mb-4\" data-kid=\"1-2-3-4-1\" data-name=\"metric icon container\">\n                    <i class=\"ti ti-rocket text-2xl\" data-kid=\"1-2-3-4-1-1\" data-name=\"rocket icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-3-4-2\" data-name=\"metric text container\">\n                    <div class=\"text-4xl font-jakarta font-bold mb-1\" data-kid=\"1-2-3-4-2-1\" data-name=\"metric static text value\">\n                        24/7\n                    </div>\n                    <div class=\"text-white/40 text-xs uppercase tracking-widest font-semibold\" data-kid=\"1-2-3-4-2-2\" data-name=\"metric label\">\n                        Soporte y Crecimiento\n                    </div>\n                </div>\n            </div>\n            <!-- Abstract Code Cell -->\n            <div class=\"bento-cell col-span-12 lg:col-span-4 row-span-1 glass-card rounded-3xl p-8 flex items-center justify-between relative overflow-hidden\" data-kid=\"1-2-3-5\" data-name=\"code bento cell\">\n                <div class=\"font-mono text-[10px] text-white/20 leading-tight\" data-kid=\"1-2-3-5-1\" data-name=\"code block container\">\n                    <div class=\"text-[#00FFFF]\" data-kid=\"1-2-3-5-1-1\" data-name=\"code keyword class\">\n                        class\n                    </div>\n                    Solution {\n                    <br data-kid=\"1-2-3-5-1-2\" data-name=\"code line break\"/>\n                    <span class=\"text-[#8A2BE2]\" data-kid=\"1-2-3-5-1-3\" data-name=\"code keyword exec\">\n                        exec\n                    </span>\n                    (input) {\n                    <br data-kid=\"1-2-3-5-1-4\" data-name=\"code line break\"/>\n                    <span class=\"text-white/40\" data-kid=\"1-2-3-5-1-5\" data-name=\"code keyword return\">\n                        return\n                    </span>\n                    deploy(input);\n                    <br data-kid=\"1-2-3-5-1-6\" data-name=\"code line break\"/>\n                    }\n                    <br data-kid=\"1-2-3-5-1-7\" data-name=\"code line break\"/>\n                    }\n                </div>\n                <div class=\"text-right\" data-kid=\"1-2-3-5-2\" data-name=\"version info container\">\n                    <div class=\"text-xs font-bold text-[#00FFFF] mb-1\" data-kid=\"1-2-3-5-2-1\" data-name=\"release status label\">\n                        STABLE RELEASE\n                    </div>\n                    <div class=\"text-2xl font-jakarta font-bold\" data-kid=\"1-2-3-5-2-2\" data-name=\"version string text\">\n                        v4.2.0\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Services Section -->\n    <section class=\"relative py-24 px-6 overflow-hidden\" data-kid=\"1-3\" data-name=\"services section\" id=\"servicios\">\n        <!-- Split Background -->\n        <div class=\"absolute inset-0 flex flex-col pointer-events-none\" data-kid=\"1-3-1\" data-name=\"section background container\">\n            <div class=\"h-1/2 bg-[#010B13]\" data-kid=\"1-3-1-1\" data-name=\"upper background layer\">\n            </div>\n            <div class=\"h-1/2 bg-[#0A0A10]\" data-kid=\"1-3-1-2\" data-name=\"lower background layer\">\n            </div>\n        </div>\n        <div class=\"max-w-7xl mx-auto relative\" data-kid=\"1-3-2\" data-name=\"services content grid\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20\" data-kid=\"1-3-2-1\" data-name=\"header and benefits row\">\n                <div class=\"lg:col-span-8\" data-kid=\"1-3-2-1-1\" data-name=\"header content container\">\n                    <div class=\"inline-block bg-[#00FFFF]/5 border border-[#00FFFF]/20 text-[#00FFFF] px-4 py-1 rounded-full text-[10px] font-bold tracking-[0.2em] mb-6\" data-kid=\"1-3-2-1-1-1\" data-name=\"header capabilities badge\">\n                        CAPACIDADES\n                    </div>\n                    <h2 class=\"font-jakarta text-4xl md:text-6xl font-extrabold mb-8 leading-tight\" data-kid=\"1-3-2-1-1-2\" data-name=\"section main title\">\n                        Puente entre la visión de negocio y la\n                        <span class=\"text-[#00FFFF] italic\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"section title highlight\">\n                            ejecución técnica\n                        </span>\n                        .\n                    </h2>\n                    <p class=\"text-white/40 text-lg max-w-2xl leading-relaxed\" data-kid=\"1-3-2-1-1-3\" data-name=\"section description text\">\n                        Sin restricciones de plataforma. Construimos sistemas que no solo funcionan, sino que escalan orgánicamente con tu infraestructura.\n                    </p>\n                </div>\n                <div class=\"lg:col-span-4 flex justify-start lg:justify-end\" data-kid=\"1-3-2-1-2\" data-name=\"benefits list container\">\n                    <div class=\"bg-[#1A1A24] border border-white/5 p-6 rounded-3xl space-y-4 w-full max-w-sm\" data-kid=\"1-3-2-1-2-1\" data-name=\"benefits box\">\n                        <div class=\"flex items-center gap-4 text-xs font-bold text-white/30 uppercase tracking-widest\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"benefit item 1\">\n                            <i class=\"ti ti-check text-[#00FFFF]\" data-kid=\"1-3-2-1-2-1-1-1\" data-name=\"checkmark icon\">\n                            </i>\n                            Soporte Multiplataforma\n                        </div>\n                        <div class=\"flex items-center gap-4 text-xs font-bold text-white/30 uppercase tracking-widest\" data-kid=\"1-3-2-1-2-1-2\" data-name=\"benefit item 2\">\n                            <i class=\"ti ti-check text-[#00FFFF]\" data-kid=\"1-3-2-1-2-1-2-1\" data-name=\"checkmark icon\">\n                            </i>\n                            Arquitectura Escalable\n                        </div>\n                        <div class=\"flex items-center gap-4 text-xs font-bold text-white/30 uppercase tracking-widest\" data-kid=\"1-3-2-1-2-1-3\" data-name=\"benefit item 3\">\n                            <i class=\"ti ti-check text-[#00FFFF]\" data-kid=\"1-3-2-1-2-1-3-1\" data-name=\"checkmark icon\">\n                            </i>\n                            Seguridad por Diseño\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\" data-kid=\"1-3-2-2\" data-name=\"services grid container\">\n                